#!/usr/bin/env bash
#/ Resolve a file or directory path and copy it to the clipboard.
#/
#/ Usage: $(basename "$0") [-h] [-v] [-r | -H] [-b] <path>
#/
#/ Available options:
#/    -h, --help       Print this help and exit
#/    -v, --verbose    Enable verbose output
#/    -r, --relative   Output path relative to current directory
#/    -H, --home       Replace home directory with $HOME in output
#/    -b, --back       Return to previous directory after copying
#/
#/ Details:
#/    Resolves the given path to an absolute form and copies it to the
#/    clipboard.  Use --relative for a CWD-relative path or --home to
#/    substitute $HOME for the literal home prefix.
#/
#/    The --back flag is intended for the case where you accidentally
#/    cd'd into a directory and want to grab a path then return.  It
#/    requires the shell function wrapper (loaded via profile) so the
#/    parent shell can cd back to $OLDPWD.
#/
#/ Examples:
#/    $(basename "$0") file.zip                # /Users/you/Desktop/file.zip
#/    $(basename "$0") ~/Desktop/file.zip      # /Users/you/Desktop/file.zip
#/    $(basename "$0") --home file.zip         # $HOME/Desktop/file.zip
#/    $(basename "$0") --relative file.zip     # file.zip
#/    $(basename "$0") --back file.zip         # copies path, then cd back

set -Eeuo pipefail
trap script.cleanup SIGINT SIGTERM ERR EXIT

source "$(dirname "$0")/../lib/bash/initrc"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)

verbose=0
relative=0
use_home=0
back=0
declare -a args=()

parse_args() {
  args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      script.usage
      ;;
    -v | --verbose)
      verbose=1
      ;;
    -r | --relative)
      relative=1
      ;;
    -H | --home)
      use_home=1
      ;;
    -b | --back)
      back=1
      ;;
    --)
      shift
      break
      ;;
    --*)
      log.error "Unknown option: $1"
      script.usage 1
      ;;
    *)
      break
      ;;
    esac
    shift
  done

  while [[ $# -gt 0 ]]; do
    args+=("$1")
    shift
  done

  if ((relative && use_home)); then
    log.error "--relative and --home are mutually exclusive"
    script.usage 1
  fi

  if ((${#args[@]} != 1)); then
    log.error "A single path argument is required"
    script.usage 1
  fi
}

main() {
  local input resolved

  input="${args[0]}"
  input=$(path.expand_user "$input")
  resolved=$(path.resolve "$input")

  if [[ ! -e $resolved ]]; then
    log.error "Path does not exist: ${args[0]}"
    exit 1
  fi

  if ((relative)); then
    resolved=$(path.relative_to "$resolved")
  elif ((use_home)); then
    resolved="${resolved/#$HOME/\$HOME}"
  fi

  printf '%s' "$resolved" | clip.copy
  log.info "Copied: $resolved"

  if ((back)); then
    if [[ -z ${OLDPWD:-} ]]; then
      log.warn "No previous directory found (\$OLDPWD is unset)"
    elif [[ $OLDPWD == "$(pwd)" ]]; then
      ((verbose)) && log.info "Already in previous directory"
    else
      log.info "Return to: $OLDPWD"
    fi
  fi
}

parse_args "$@"
main
