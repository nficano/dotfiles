#!/usr/bin/env bash
#/ Best-quality file format conversions powered by ffmpeg (and friends).
#/
#/ Usage: $(basename "$0") [-h] [-v] <input> <output> [-- extra_ffmpeg_args...]
#/        $(basename "$0") [-h] [-v] <input>... <ext|.ext|*.ext> [-- extra_ffmpeg_args...]
#/
#/ Available options:
#/    -h, --help      Print this help and exit
#/    -v, --verbose   Enable verbose output
#/
#/ Supported conversions:
#/    Audio:     mp3, aac, m4a, wav, flac, ogg, opus, wma, alac
#/    Video:     mp4, mov, mkv, webm, avi, m4v, mpg, mpeg, ts, m2ts
#/    Image:     jpg, jpeg, png, webp, gif, bmp, tif, tiff, heic, avif, svg (ai->svg via inkscape, pdf->image via poppler/imagemagick, svg->raster via librsvg/inkscape/imagemagick)
#/    Fonts:     ttf, otf, woff, woff2, svg (requires fontforge)
#/    Docs:      pdf, txt, md, html, csv (requires pandoc/libreoffice/jq)
#/    Subtitles: srt, vtt, ass, ssa, sub (via ffmpeg)
#/    eBooks:    epub, mobi, azw3, fb2, lit, pdb, lrf (requires calibre's ebook-convert; pandoc for md/html->epub)
#/    OCR:       image/pdf -> txt (tesseract/pdftotext); pdf -> searchable pdf (ocrmypdf)
#/
#/ Examples:
#/    $(basename "$0") input.mp4 output.mov
#/    $(basename "$0") song.wav song.mp3
#/    $(basename "$0") clip.mp4 audio.flac
#/    $(basename "$0") video.mp4 video.gif
#/    $(basename "$0") image.png image.webp -- -compression_level 6
#/    $(basename "$0") scan.pdf page-1.png
#/    $(basename "$0") scan.pdf 'page-%02d.png'   # multi-page rasterize
#/    $(basename "$0") subs.srt subs.vtt
#/    $(basename "$0") book.md book.epub
#/    $(basename "$0") scanned.pdf searchable.pdf # OCR via ocrmypdf
#/    $(basename "$0") receipt.jpg receipt.txt    # OCR via tesseract
#/    $(basename "$0") *.svg *.png                # batch: every .svg -> sibling .png
#/    $(basename "$0") *.heic jpg                 # batch: every .heic -> sibling .jpg

set -Eeuo pipefail
trap script.cleanup SIGINT SIGTERM ERR EXIT

source "$(dirname "$0")/../lib/bash/initrc"

verbose=0
declare -a EXTRA_FFMPEG_ARGS=()
declare -a POSITIONALS=()
IN=""
OUT=""

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help) script.usage ;;
    -v | --verbose) verbose=1 ;;
    --)
      shift
      EXTRA_FFMPEG_ARGS=("$@")
      return 0
      ;;
    -*)
      log.error "Unknown option: $1"
      script.usage 1
      ;;
    *)
      POSITIONALS+=("$1")
      ;;
    esac
    shift
  done

  (( ${#POSITIONALS[@]} >= 2 )) || {
    log.error "Both <input> and <output> are required"
    script.usage 1
  }
}

ext_of() {
  path.suffix "$1" | str.lower | sed 's/^\.//'
}

mime_hint() {
  if command -v file >/dev/null 2>&1 && [[ -f $1 ]]; then
    file --brief --mime-type "$1" 2>/dev/null || true
  fi
}

is_video_ext() {
  case "$1" in
  mp4 | mov | mkv | webm | avi | m4v | mpg | mpeg | ts | m2ts) return 0 ;;
  *) return 1 ;;
  esac
}

is_audio_ext() {
  case "$1" in
  mp3 | aac | m4a | wav | flac | ogg | opus | wma | alac) return 0 ;;
  *) return 1 ;;
  esac
}

is_image_ext() {
  case "$1" in
  jpg | jpeg | png | webp | gif | bmp | tif | tiff | heic | avif | svg) return 0 ;;
  *) return 1 ;;
  esac
}

is_doc_ext() {
  case "$1" in
  pdf | txt | md | html | rtf | docx | odt | pptx | xlsx | csv | json | xml | yaml | yml) return 0 ;;
  *) return 1 ;;
  esac
}

is_font_ext() {
  case "$1" in
  ttf | otf | woff | woff2 | svg) return 0 ;;
  *) return 1 ;;
  esac
}

is_subtitle_ext() {
  case "$1" in
  srt | vtt | ass | ssa | sub) return 0 ;;
  *) return 1 ;;
  esac
}

is_ebook_ext() {
  case "$1" in
  epub | mobi | azw3 | fb2 | lit | pdb | lrf | kfx) return 0 ;;
  *) return 1 ;;
  esac
}

is_known_ext() {
  is_image_ext "$1" || is_audio_ext "$1" || is_video_ext "$1" \
    || is_doc_ext "$1" || is_font_ext "$1" || is_subtitle_ext "$1" \
    || is_ebook_ext "$1"
}

ext_token_value() {
  local tok="$1" ext
  case "$tok" in
  \*.*) ext="${tok#\*.}" ;;
  .*)   ext="${tok#.}" ;;
  *.*)  return 1 ;;
  *)    ext="$tok" ;;
  esac
  [[ "$ext" =~ ^[a-zA-Z0-9]+$ ]] || return 1
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  is_known_ext "$ext" || return 1
  printf '%s' "$ext"
}

ensure_out_dir() {
  local d
  d="$(path.parent "$OUT")"
  [[ "$d" == "." ]] || path.mkdir -p "$d"
}

run_ffmpeg() {
  guards.require_exec ffmpeg
  ensure_out_dir
  ((verbose)) && log.info "ffmpeg $*"
  ffmpeg -hide_banner -loglevel error -y "$@"
}

convert_to_audio() {
  local acodec="" args=()
  case "$OUT_EXT" in
  flac) acodec="flac"; args=(-compression_level 0) ;;
  wav) acodec="pcm_s24le" ;;
  alac) acodec="alac" ;;
  mp3) acodec="libmp3lame"; args=(-q:a 0) ;;
  aac | m4a) acodec="aac"; args=(-q:a 1) ;;
  opus) acodec="libopus"; args=(-b:a 256k) ;;
  ogg) acodec="libvorbis"; args=(-q:a 10) ;;
  *) log.error "Audio output not supported: .$OUT_EXT"; exit 1 ;;
  esac
  run_ffmpeg -i "$IN" -vn -c:a "$acodec" "${args[@]}" "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
}

convert_to_video() {
  local vcodec="" acodec="" args=()
  case "$OUT_EXT" in
  mp4 | m4v)
    vcodec="libx264"; acodec="aac"
    args=(-pix_fmt yuv420p -crf 16 -preset slow -movflags +faststart -profile:v high -level 4.2)
    ;;
  mov)
    vcodec="prores_ks"; acodec="pcm_s24le"
    args=(-profile:v 3 -pix_fmt yuv422p10le)
    ;;
  mkv)
    vcodec="libx264"; acodec="flac"
    args=(-pix_fmt yuv420p -crf 16 -preset slow)
    ;;
  webm)
    vcodec="libvpx-vp9"; acodec="libopus"
    args=(-crf 15 -b:v 0 -row-mt 1)
    ;;
  avi)
    vcodec="ffv1"; acodec="pcm_s24le"
    ;;
  mpg | mpeg)
    vcodec="mpeg2video"; acodec="pcm_s16le"
    args=(-q:v 1)
    ;;
  ts | m2ts)
    vcodec="libx264"; acodec="aac"
    args=(-pix_fmt yuv420p -crf 16 -preset slow)
    ;;
  *) log.error "Video output not supported: .$OUT_EXT"; exit 1 ;;
  esac
  run_ffmpeg -i "$IN" -c:v "$vcodec" -c:a "$acodec" "${args[@]}" "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
}

convert_pdf_multipage() {
  local fmt
  case "$OUT_EXT" in
  png) fmt=png ;;
  jpg | jpeg) fmt=jpeg ;;
  tif | tiff) fmt=tiff ;;
  *)
    log.error "Multi-page PDF rasterize supports png/jpg/tiff (got .$OUT_EXT)"
    exit 1
    ;;
  esac

  local tmpdir tmpbase
  tmpdir="$(fs.mktmp dir ttt_pdf_multi)" || {
    log.error "Failed to create temporary directory for multi-page PDF"
    exit 1
  }
  tmpbase="$(path.join "$tmpdir" "page")"

  ensure_out_dir
  if command -v pdftocairo >/dev/null 2>&1; then
    ((verbose)) && log.info "Rasterizing all PDF pages via pdftocairo"
    pdftocairo "-${fmt}" -r 300 "$IN" "$tmpbase" >/dev/null 2>&1
  elif command -v pdftoppm >/dev/null 2>&1; then
    ((verbose)) && log.info "Rasterizing all PDF pages via pdftoppm"
    pdftoppm "-${fmt}" -r 300 "$IN" "$tmpbase" >/dev/null 2>&1
  else
    rm -rf -- "$tmpdir"
    log.error "Multi-page PDF rasterize requires poppler (pdftocairo/pdftoppm)"
    exit 1
  fi

  local i=1 dest p
  while IFS= read -r p; do
    printf -v dest "$OUT" "$i"
    mv -f "$p" "$dest"
    i=$((i + 1))
  done < <(find "$tmpdir" -type f -name 'page-*' | sort -V)

  rm -rf -- "$tmpdir"
  if [[ $i -eq 1 ]]; then
    log.error "No pages produced from $IN"
    exit 1
  fi
  ((verbose)) && log.info "Wrote $((i - 1)) pages"
}

convert_to_image() {
  if [[ "$IN_EXT" == "pdf" || "$IN_MIME" == "application/pdf" ]]; then
    if [[ "$OUT" == *%* ]]; then
      convert_pdf_multipage
      return 0
    fi
    local tmpdir tmpbase tmp_png
    tmpdir="$(fs.mktmp dir ttt_pdf)" || {
      log.error "Failed to create temporary directory for PDF conversion"
      exit 1
    }
    tmpbase="$(path.join "$tmpdir" "page-1")"
    tmp_png="${tmpbase}.png"

    if command -v pdftocairo >/dev/null 2>&1; then
      ((verbose)) && log.info "Rasterizing first PDF page via pdftocairo"
      pdftocairo -png -singlefile -f 1 -l 1 -r 300 "$IN" "$tmpbase" >/dev/null 2>&1
    elif command -v pdftoppm >/dev/null 2>&1; then
      ((verbose)) && log.info "Rasterizing first PDF page via pdftoppm"
      pdftoppm -png -singlefile -f 1 -l 1 -r 300 "$IN" "$tmpbase" >/dev/null 2>&1
    elif command -v magick >/dev/null 2>&1; then
      ((verbose)) && log.info "Rasterizing first PDF page via ImageMagick"
      magick -density 300 "${IN}[0]" -background white -alpha remove "$tmp_png" >/dev/null 2>&1
    else
      rm -rf -- "$tmpdir"
      log.error "PDF->image requires poppler (pdftocairo/pdftoppm) or ImageMagick (magick)"
      exit 1
    fi

    guards.require_file "$tmp_png"

    case "$OUT_EXT" in
    png)
      run_ffmpeg -i "$tmp_png" -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    webp)
      run_ffmpeg -i "$tmp_png" -lossless 1 -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    jpg | jpeg)
      run_ffmpeg -i "$tmp_png" -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    gif)
      run_ffmpeg -loop 1 -i "$tmp_png" -frames:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    tif | tiff)
      run_ffmpeg -i "$tmp_png" -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    bmp | avif | heic)
      run_ffmpeg -i "$tmp_png" -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    svg)
      if command -v pdftocairo >/dev/null 2>&1; then
        ensure_out_dir
        ((verbose)) && log.info "Converting first PDF page to SVG via pdftocairo"
        pdftocairo -svg -singlefile -f 1 -l 1 "$IN" "$OUT" >/dev/null 2>&1
      else
        rm -rf -- "$tmpdir"
        log.error "PDF->svg requires pdftocairo (poppler)"
        exit 1
      fi
      ;;
    *)
      rm -rf -- "$tmpdir"
      log.error "Image output not supported: .$OUT_EXT"
      exit 1
      ;;
    esac

    rm -rf -- "$tmpdir"
    return 0
  fi

  if [[ "$IN_EXT" == "svg" || "$IN_MIME" == "image/svg+xml" ]] && [[ "$OUT_EXT" != "svg" ]]; then
    local tmpdir tmp_png
    tmpdir="$(fs.mktmp dir ttt_svg)" || {
      log.error "Failed to create temporary directory for SVG conversion"
      exit 1
    }
    tmp_png="$(path.join "$tmpdir" "rasterized.png")"

    if command -v rsvg-convert >/dev/null 2>&1; then
      ((verbose)) && log.info "Rasterizing SVG via rsvg-convert"
      rsvg-convert -d 300 -p 300 -f png -o "$tmp_png" "$IN" >/dev/null 2>&1
    elif command -v inkscape >/dev/null 2>&1; then
      ((verbose)) && log.info "Rasterizing SVG via inkscape"
      inkscape "$IN" --export-type=png --export-filename="$tmp_png" --export-dpi=300 >/dev/null 2>&1
    elif command -v magick >/dev/null 2>&1; then
      ((verbose)) && log.info "Rasterizing SVG via ImageMagick"
      magick -density 300 -background none "$IN" "$tmp_png" >/dev/null 2>&1
    else
      rm -rf -- "$tmpdir"
      log.error "SVG->raster requires librsvg (rsvg-convert), inkscape, or ImageMagick (magick)"
      exit 1
    fi

    guards.require_file "$tmp_png"

    case "$OUT_EXT" in
    png)
      ensure_out_dir
      mv -f "$tmp_png" "$OUT"
      ;;
    webp)
      run_ffmpeg -i "$tmp_png" -lossless 1 -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    jpg | jpeg)
      run_ffmpeg -i "$tmp_png" -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    gif)
      run_ffmpeg -loop 1 -i "$tmp_png" -frames:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    tif | tiff)
      run_ffmpeg -i "$tmp_png" -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    bmp | avif | heic)
      run_ffmpeg -i "$tmp_png" -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
      ;;
    *)
      rm -rf -- "$tmpdir"
      log.error "Image output not supported: .$OUT_EXT"
      exit 1
      ;;
    esac

    rm -rf -- "$tmpdir"
    return 0
  fi

  case "$OUT_EXT" in
  png)
    run_ffmpeg -i "$IN" -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    ;;
  webp)
    run_ffmpeg -i "$IN" -lossless 1 -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    ;;
  jpg | jpeg)
    if is_video_ext "$IN_EXT" || [[ "$IN_MIME" == video/* ]]; then
      run_ffmpeg -ss 0 -i "$IN" -frames:v 1 -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    else
      run_ffmpeg -i "$IN" -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    fi
    ;;
  gif)
    local vf="fps=15,scale=960:-1:flags=lanczos"
    ensure_out_dir
    guards.require_exec ffmpeg
    ((verbose)) && log.info "Generating optimized GIF with palettegen"
    ffmpeg -hide_banner -loglevel error -y -i "$IN" \
      -vf "${vf},palettegen=stats_mode=full" /tmp/ttt_palette.png
    ffmpeg -hide_banner -loglevel error -y -i "$IN" -i /tmp/ttt_palette.png \
      -lavfi "${vf} [x]; [x][1:v] paletteuse=dither=bayer:bayer_scale=3" \
      "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    rm -f /tmp/ttt_palette.png
    ;;
  tif | tiff)
    run_ffmpeg -i "$IN" -compression_level 0 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    ;;
  avif | heic)
    run_ffmpeg -i "$IN" -q:v 1 "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
    ;;
  svg)
    if [[ "$IN_EXT" == "ai" ]]; then
      guards.require_exec inkscape
      ((verbose)) && log.info "Converting via inkscape"
      inkscape "$IN" --export-type=svg --export-filename="$OUT" >/dev/null 2>&1
    else
      log.error "SVG output not supported via ffmpeg; use inkscape or ImageMagick"
      exit 1
    fi
    ;;
  *) log.error "Image output not supported: .$OUT_EXT"; exit 1 ;;
  esac
}

convert_docs() {
  ensure_out_dir
  case "$OUT_EXT" in
  pdf)
    if [[ "$IN_EXT" == "pdf" || "$IN_MIME" == "application/pdf" ]]; then
      guards.require_exec ocrmypdf
      ((verbose)) && log.info "Running OCR via ocrmypdf"
      ocrmypdf "$IN" "$OUT" >/dev/null 2>&1
      return 0
    fi
    if [[ "$IN_EXT" =~ ^(md|html|htm|txt|rtf)$ ]]; then
      guards.require_exec pandoc
      ((verbose)) && log.info "Converting via pandoc"
      pandoc "$IN" --pdf-engine=xelatex -o "$OUT"
      return 0
    elif [[ "$IN_EXT" == "svg" ]]; then
      guards.require_exec inkscape
      ((verbose)) && log.info "Converting via inkscape"
      inkscape "$IN" --export-type=pdf --export-filename="$OUT" >/dev/null 2>&1
      return 0
    elif is_ebook_ext "$IN_EXT"; then
      convert_ebook
      return 0
    else
      if command -v soffice >/dev/null 2>&1; then
        local outdir produced
        outdir="$(path.parent "$OUT")"
        ((verbose)) && log.info "Converting via libreoffice"
        soffice --headless --convert-to pdf --outdir "$outdir" "$IN" >/dev/null 2>&1
        produced="$outdir/$(path.stem "$IN").pdf"
        guards.require_file "$produced"
        mv -f "$produced" "$OUT"
        return 0
      fi
      if command -v unoconv >/dev/null 2>&1; then
        unoconv -f pdf -o "$OUT" "$IN"
        return 0
      fi
      log.error "No tool available for document->pdf (install pandoc, libreoffice, or unoconv)"
      exit 1
    fi
    ;;
  csv)
    if [[ "$IN_EXT" == "json" ]]; then
      guards.require_exec jq
      ((verbose)) && log.info "Converting JSON to CSV via jq"
      jq -r '
        (.[0] | keys_unsorted) as $cols
        | $cols,
          map([.[ $cols[] ]] )[]
        | @csv
      ' "$IN" >"$OUT"
      return 0
    fi
    if command -v ssconvert >/dev/null 2>&1; then
      ssconvert "$IN" "$OUT" >/dev/null 2>&1
      return 0
    fi
    log.error "No tool available for ->csv (install jq for JSON, or gnumeric ssconvert for spreadsheets)"
    exit 1
    ;;
  md | html | txt)
    if [[ "$OUT_EXT" == "txt" ]]; then
      if [[ "$IN_EXT" == "pdf" || "$IN_MIME" == "application/pdf" ]]; then
        if command -v pdftotext >/dev/null 2>&1; then
          ((verbose)) && log.info "Extracting text via pdftotext"
          pdftotext -layout "$IN" "$OUT"
          return 0
        fi
        guards.require_exec ocrmypdf
        ((verbose)) && log.info "Extracting text via ocrmypdf --sidecar"
        ocrmypdf --sidecar "$OUT" "$IN" /dev/null >/dev/null 2>&1
        return 0
      fi
      if is_image_ext "$IN_EXT" || [[ "$IN_MIME" == image/* ]]; then
        guards.require_exec tesseract
        ((verbose)) && log.info "OCR via tesseract"
        tesseract "$IN" "${OUT%.txt}" >/dev/null 2>&1
        return 0
      fi
    fi
    if is_ebook_ext "$IN_EXT"; then
      convert_ebook
      return 0
    fi
    guards.require_exec pandoc
    ((verbose)) && log.info "Converting via pandoc"
    pandoc "$IN" -o "$OUT"
    ;;
  *)
    log.error "Document output not supported: .$OUT_EXT"
    exit 1
    ;;
  esac
}

convert_subtitles() {
  guards.require_exec ffmpeg
  ensure_out_dir
  ((verbose)) && log.info "Converting subtitles via ffmpeg"
  ffmpeg -hide_banner -loglevel error -y -i "$IN" "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
}

convert_ebook() {
  ensure_out_dir
  if [[ "$OUT_EXT" == "epub" && "$IN_EXT" =~ ^(md|markdown|html|htm|txt|rst|docx|odt|tex)$ ]]; then
    guards.require_exec pandoc
    ((verbose)) && log.info "Converting via pandoc"
    pandoc "$IN" -o "$OUT"
    return 0
  fi
  guards.require_exec ebook-convert
  ((verbose)) && log.info "Converting via ebook-convert (Calibre)"
  ebook-convert "$IN" "$OUT" >/dev/null 2>&1
}

convert_fonts() {
  ensure_out_dir
  guards.require_exec fontforge
  ((verbose)) && log.info "Converting via fontforge"
  fontforge -lang=ff -c 'Open($1); Generate($2);' "$IN" "$OUT" 2>/dev/null
}

convert_one() {
  IN="$1"
  OUT="$2"

  guards.require_file "$IN"
  [[ "$IN" != "$OUT" ]] || { log.error "Input and output are the same path: $IN"; exit 1; }

  IN_EXT="$(ext_of "$IN")"
  OUT_EXT="$(ext_of "$OUT")"
  IN_MIME="$(mime_hint "$IN")"

  if path.isdir "$OUT"; then
    if [[ -n $OUT_EXT ]]; then
      local parent base stem ext candidate i
      parent="$(path.parent "$OUT")"
      base="$(path.basename "$OUT")"
      stem="$(path.stem "$base")"
      ext="${OUT_EXT:-out}"
      candidate="$(path.join "$parent" "${stem}.${ext}")"
      i=1
      while path.exists "$candidate"; do
        candidate="$(path.join "$parent" "${stem}-${i}.${ext}")"
        i=$((i + 1))
      done
      OUT="$candidate"
      ((verbose)) && log.info "Output path is a directory; writing to $OUT"
    else
      local use_ext
      use_ext="${IN_EXT:-out}"
      OUT="$(path.join "$OUT" "$(path.stem "$IN").${use_ext}")"
      ((verbose)) && log.info "Output is a directory; writing to $OUT"
    fi
  fi

  guards.nonempty "$OUT_EXT" "output extension"

  ((verbose)) && log.info "Converting $IN ($IN_EXT) -> $OUT ($OUT_EXT)"

  if is_audio_ext "$OUT_EXT"; then
    convert_to_audio
  elif is_video_ext "$OUT_EXT"; then
    convert_to_video
  elif is_subtitle_ext "$OUT_EXT" && is_subtitle_ext "$IN_EXT"; then
    convert_subtitles
  elif is_ebook_ext "$OUT_EXT"; then
    convert_ebook
  elif is_font_ext "$OUT_EXT"; then
    if is_font_ext "$IN_EXT"; then
      convert_fonts
    else
      log.error "Font conversions require font input (.ttf/.otf/.woff/.woff2/.svg)"
      exit 1
    fi
  elif is_image_ext "$OUT_EXT"; then
    convert_to_image
  elif is_doc_ext "$OUT_EXT"; then
    convert_docs
  else
    ((verbose)) && log.info "Unknown output type; falling back to ffmpeg"
    run_ffmpeg -i "$IN" "${EXTRA_FFMPEG_ARGS[@]+"${EXTRA_FFMPEG_ARGS[@]}"}" "$OUT"
  fi

  log.success "Created $OUT"
}

derive_batch_out() {
  local src="$1" ext="$2" parent stem
  parent="$(path.parent "$src")"
  stem="$(path.stem "$src")"
  if [[ "$parent" == "." || -z "$parent" ]]; then
    printf '%s.%s' "$stem" "$ext"
  else
    path.join "$parent" "${stem}.${ext}"
  fi
}

main() {
  parse_args "$@"

  local last_idx=$(( ${#POSITIONALS[@]} - 1 ))
  local last="${POSITIONALS[$last_idx]}"
  local target_ext=""
  target_ext="$(ext_token_value "$last" 2>/dev/null || true)"

  if [[ -n "$target_ext" ]]; then
    local -a inputs=("${POSITIONALS[@]:0:$last_idx}")
    (( ${#inputs[@]} >= 1 )) || {
      log.error "No input files provided"
      script.usage 1
    }
    ((verbose)) && log.info "Batch mode: ${#inputs[@]} input(s) -> .$target_ext"
    local src dst
    for src in "${inputs[@]}"; do
      dst="$(derive_batch_out "$src" "$target_ext")"
      convert_one "$src" "$dst"
    done
    return 0
  fi

  (( ${#POSITIONALS[@]} == 2 )) || {
    log.error "Expected <input> <output>, or <input>... <ext>; got ${#POSITIONALS[@]} arguments"
    script.usage 1
  }
  convert_one "${POSITIONALS[0]}" "${POSITIONALS[1]}"
}

main "$@"
