#!/usr/bin/env bash
#/ Upload a file or clipboard contents to S3 and copy the shareable URL to the clipboard.
#/
#/ Usage: $(basename "$0") [-h] [-v] [-e SECONDS] [-t] <file>
#/        $(basename "$0") [-h] [-v] [-e SECONDS] -c [-n NAME]
#/
#/ Available options:
#/    -h, --help            Print this help and exit
#/    -v, --verbose         Enable verbose output
#/    -e, --ttl SECONDS     HTTP expiry TTL in seconds (default: 86400 = 24 hours)
#/    -t, --trash           Move the local file to Trash after upload and clipboard copy
#/    -c, --clipboard       Upload text from the clipboard instead of a file
#/    -n, --name NAME       Clipboard filename used for its extension (default: clipboard.txt)
#/
#/ Environment variables:
#/    S3_UPLOAD_LINK_BUCKET        Required S3 bucket name (accepts optional s3:// prefix)
#/    S3_UPLOAD_LINK_PREFIX        Optional key prefix for uploaded objects
#/    S3_UPLOAD_LINK_URL_BASE      Optional https:// base used to build share URLs
#/    S3_UPLOAD_LINK_BUCKET_REGION Optional bucket region for default URL generation
#/    S3_UPLOAD_LINK_ACL           Optional ACL for aws s3 cp (default: public-read)
#/    S3_UPLOAD_LINK_CACHE_CONTROL Optional Cache-Control header value
#/    S3_UPLOAD_LINK_CONTENT_TYPE  Optional Content-Type override
#/    S3_UPLOAD_LINK_ID_LENGTH     Optional length for generated NanoID filenames (default: 12)
#/    S3_UPLOAD_LINK_DOMAIN_MAP    Optional comma-separated bucket=domain pairs for custom share URLs
#/    S3_UPLOAD_LINK_EXPIRES_IN    Optional HTTP expiry TTL in seconds (default: 86400)
#/    S3_UPLOAD_LINK_NO_LIFECYCLE  Set to 1 to omit the s3-upload-ttl=24h object tag
#/
#/ Examples:
#/    $(basename "$0") ~/Downloads/screenshot.png
#/    $(basename "$0") --trash ~/Documents/Screenshots/screenshot.png
#/    $(basename "$0") --clipboard
#/    $(basename "$0") --clipboard --name snippet.json

set -Eeuo pipefail

source "$(dirname "$0")/../lib/bash/initrc"

verbose=0
file_path=""
ttl=""
clipboard_mode=0
clipboard_filename="clipboard.txt"
clipboard_name_set=0
clipboard_temp=""
trash_after_upload=0

cleanup() {
  if ((${BASH_SUBSHELL:-0} == 0)) && [[ -n $clipboard_temp && -f $clipboard_temp ]]; then
    rm -f -- "$clipboard_temp"
  fi
  script.cleanup
}

trap cleanup SIGINT SIGTERM ERR EXIT

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      script.usage
      ;;
    -v | --verbose)
      verbose=1
      ;;
    -e | --ttl)
      shift
      [[ $# -gt 0 ]] || {
        log.error "Missing value for --ttl"
        script.usage 1
      }
      ttl="$1"
      ;;
    -t | --trash)
      trash_after_upload=1
      ;;
    -c | --clipboard)
      clipboard_mode=1
      ;;
    -n | --name)
      shift
      [[ $# -gt 0 ]] || {
        log.error "Missing value for --name"
        script.usage 1
      }
      clipboard_filename="$1"
      clipboard_name_set=1
      ;;
    --)
      shift
      break
      ;;
    --*)
      log.error "Unknown option: $1"
      script.usage 1
      ;;
    *)
      break
      ;;
    esac
    shift
  done

  if ((clipboard_mode && trash_after_upload)); then
    log.error "--clipboard and --trash cannot be used together"
    script.usage 1
  fi

  if ((clipboard_mode)); then
    if (($# > 0)); then
      log.error "A file path cannot be used with --clipboard"
      script.usage 1
    fi
    if [[ -z $clipboard_filename || $clipboard_filename == */* ]]; then
      log.error "Clipboard name must be a filename, not a path"
      script.usage 1
    fi
    return
  fi

  if ((clipboard_name_set)); then
    log.error "--name may only be used with --clipboard"
    script.usage 1
  fi

  if (($# == 0)); then
    log.error "A file path is required"
    script.usage 1
  fi

  if (($# > 1)); then
    log.error "Only one file path may be provided"
    script.usage 1
  fi

  file_path="$1"
}

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    log.error "Required command not found: $cmd"
    exit 1
  fi
}

sanitize_filename() {
  local name="$1" sanitized
  sanitized=${name//[![:alnum:]_.-]/-}
  while [[ $sanitized == *--* ]]; do
    sanitized=${sanitized//--/-}
  done
  sanitized=${sanitized##-}
  sanitized=${sanitized%%-}
  if [[ -z $sanitized ]]; then
    sanitized="file"
  fi
  printf '%s\n' "$sanitized"
}

build_share_url() {
  local bucket="$1"
  local key="$2"
  local url_base="${S3_UPLOAD_LINK_URL_BASE:-}"
  local region="${S3_UPLOAD_LINK_BUCKET_REGION:-}"
  local host
  local mapped

  if [[ -n $url_base ]]; then
    url_base="${url_base%/}"
    printf '%s/%s\n' "$url_base" "$key"
    return
  fi

  if mapped=$(lookup_domain_mapping "$bucket"); then
    mapped=${mapped%/}
    if [[ $mapped == http://* || $mapped == https://* ]]; then
      printf '%s/%s\n' "$mapped" "$key"
    else
      printf 'https://%s/%s\n' "$mapped" "$key"
    fi
    return
  fi

  if [[ -n $region && $region != "us-east-1" ]]; then
    host="${bucket}.s3.${region}.amazonaws.com"
  else
    host="${bucket}.s3.amazonaws.com"
  fi

  printf 'https://%s/%s\n' "$host" "$key"
}

lookup_domain_mapping() {
  local bucket="$1"
  local map="${S3_UPLOAD_LINK_DOMAIN_MAP:-}"
  [[ -n $map ]] || return 1

  local -a pairs=()
  local entry key value
  local IFS=','

  read -ra pairs <<<"$map"
  for entry in "${pairs[@]}"; do
    entry="$(str.trim "$entry")"
    [[ -n $entry && $entry == *=* ]] || continue
    key="${entry%%=*}"
    value="${entry#*=}"
    key="$(str.trim "$key")"
    value="$(str.trim "$value")"
    if [[ $key == "$bucket" && -n $value ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done

  return 1
}

compute_expiry_timestamp() {
  local ttl="$1"
  local now target iso

  now=$(date -u +%s)
  target=$((now + ttl))

  if iso=$(date -u -d "@${target}" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null); then
    printf '%s\n' "$iso"
    return 0
  fi

  if iso=$(date -u -r "$target" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null); then
    printf '%s\n' "$iso"
    return 0
  fi

  log.error "Unable to compute expiration timestamp; unsupported 'date' command"
  return 1
}

build_object_key() {
  local id="$1"
  local prefix="$2"
  local filename="$3"
  local sanitized="$4"
  local ext=""

  if [[ $filename == *.* && $filename != "${filename%.*}" ]]; then
    ext=".${filename##*.}"
    ext=${ext//[^[:alnum:]._-]/-}
    while [[ $ext == *--* ]]; do
      ext=${ext//--/-}
    done
  fi

  if [[ -z $ext ]]; then
    if [[ $sanitized == *.* && $sanitized != "${sanitized%.*}" ]]; then
      ext=".${sanitized##*.}"
    fi
  fi

  if [[ -n $ext && ${ext:0:1} != '.' ]]; then
    ext=".${ext}"
  fi

  local key="${id}${ext}"

  if [[ -n $prefix ]]; then
    prefix="${prefix#/}"
    prefix="${prefix%/}"
    if [[ -n $prefix ]]; then
      key="${prefix}/${key}"
    fi
  fi

  printf '%s\n' "$key"
}

main() {
  local resolved bucket prefix filename sanitized id_len object_id object_key expires_iso s3_uri share_url acl content_type lifecycle_pref copy_pref trash_cmd
  local -a aws_cmd

  deps.require aws awscli

  copy_pref="${S3_UPLOAD_LINK_NO_CLIP:-0}"
  if ((trash_after_upload)); then
    os.require_macos
    if [[ $copy_pref == 1 || $copy_pref == true || $copy_pref == True ]]; then
      log.error "--trash requires clipboard copying to be enabled"
      exit 1
    fi
    trash_cmd="${S3_UPLOAD_TRASH_CMD:-/usr/bin/trash}"
  fi

  if ((clipboard_mode)); then
    if ! clipboard_temp=$(fs.mktmp file s3-upload-clipboard); then
      log.error "Failed to create a temporary file for clipboard contents"
      exit 1
    fi
    if ! clip.paste >"$clipboard_temp"; then
      log.error "Failed to read text from the clipboard"
      exit 1
    fi
    if [[ ! -s $clipboard_temp ]]; then
      log.error "Clipboard does not contain any text"
      exit 1
    fi
    resolved="$clipboard_temp"
    filename="$clipboard_filename"
  else
    resolved=$(path.resolve "$file_path")
    if ! fs.isfile "$resolved"; then
      log.error "File not found: $file_path"
      exit 1
    fi
    filename=$(basename -- "$resolved")
  fi

  bucket="${S3_UPLOAD_LINK_BUCKET:-}"
  if [[ -z $bucket ]]; then
    log.error "S3_UPLOAD_LINK_BUCKET must be set"
    exit 1
  fi

  prefix="${S3_UPLOAD_LINK_PREFIX:-}"
  prefix="${prefix#/}"
  prefix="${prefix%/}"

  bucket="${bucket#s3://}"
  if [[ $bucket == */* ]]; then
    local bucket_prefix="${bucket#*/}"
    bucket="${bucket%%/*}"
    bucket_prefix="${bucket_prefix#/}"
    bucket_prefix="${bucket_prefix%/}"
    if [[ -n $bucket_prefix ]]; then
      if [[ -n $prefix ]]; then
        prefix="${bucket_prefix}/${prefix}"
      else
        prefix="$bucket_prefix"
      fi
    fi
  fi

  if [[ -z $bucket ]]; then
    log.error "S3_UPLOAD_LINK_BUCKET does not contain a valid bucket name"
    exit 1
  fi

  sanitized=$(sanitize_filename "$filename")

  require_command nanoid

  id_len="${S3_UPLOAD_LINK_ID_LENGTH:-12}"
  script.validate_positive_int "$id_len" "S3_UPLOAD_LINK_ID_LENGTH"

  local attempt=0
  while true; do
    if object_id=$(nanoid -l "$id_len"); then
      if [[ -n $object_id ]]; then
        break
      fi
      log.warn "nanoid returned empty string (attempt=$((attempt + 1)))"
    else
      log.warn "nanoid command failed (attempt=$((attempt + 1)))"
    fi

    attempt=$((attempt + 1))
    if ((attempt >= 10)); then
      log.error "Failed to generate NanoID filename after ${attempt} attempts"
      exit 1
    fi
    sleep 0.1
  done

  object_key=$(build_object_key "$object_id" "$prefix" "$filename" "$sanitized")

  local effective_ttl="${ttl:-${S3_UPLOAD_LINK_EXPIRES_IN:-86400}}"
  script.validate_positive_int "$effective_ttl" "TTL"
  if ! expires_iso=$(compute_expiry_timestamp "$effective_ttl"); then
    exit 1
  fi

  s3_uri="s3://${bucket}/${object_key}"

  acl="${S3_UPLOAD_LINK_ACL:-public-read}"
  aws_cmd=(aws s3 cp "$resolved" "$s3_uri" --only-show-errors)
  if [[ -n $acl ]]; then
    aws_cmd+=(--acl "$acl")
  fi
  if [[ -n ${S3_UPLOAD_LINK_CACHE_CONTROL:-} ]]; then
    aws_cmd+=(--cache-control "${S3_UPLOAD_LINK_CACHE_CONTROL}")
  fi
  content_type="${S3_UPLOAD_LINK_CONTENT_TYPE:-}"
  if ((clipboard_mode)) && [[ -z $content_type ]]; then
    content_type="text/plain; charset=utf-8"
  fi
  if [[ -n $content_type ]]; then
    aws_cmd+=(--content-type "$content_type")
  fi
  if [[ -n ${expires_iso:-} ]]; then
    aws_cmd+=(--expires "$expires_iso")
  fi

  ((verbose)) && log.info "Uploading ${filename} to ${s3_uri}"

  if ! "${aws_cmd[@]}"; then
    log.error "Failed to upload file to S3"
    exit 1
  fi

  lifecycle_pref="${S3_UPLOAD_LINK_NO_LIFECYCLE:-0}"
  if [[ $lifecycle_pref != 1 && $lifecycle_pref != true && $lifecycle_pref != True ]]; then
    if ! aws s3api put-object-tagging \
      --bucket "$bucket" \
      --key "$object_key" \
      --tagging 'TagSet=[{Key=s3-upload-ttl,Value=24h}]'; then
      log.error "Uploaded the file, but failed to apply its 24-hour lifecycle tag"
      exit 1
    fi
  fi

  share_url=$(build_share_url "$bucket" "$object_key")

  if [[ $copy_pref != 1 && $copy_pref != true && $copy_pref != True ]]; then
    if ! clip.copy <<<"$share_url"; then
      if ((trash_after_upload)); then
        log.error "Failed to copy URL to clipboard; keeping local file: $resolved"
        exit 1
      fi
      log.warn "Failed to copy URL to clipboard; continuing"
    elif ((verbose)); then
      log.info "Copied URL to clipboard"
    fi
  fi

  if ((trash_after_upload)); then
    if ! "$trash_cmd" "$resolved"; then
      log.error "Uploaded file but could not move it to Trash: $resolved"
      exit 1
    fi
    ((verbose)) && log.info "Moved local file to Trash: $resolved"
  fi

  printf '%s\n' "$share_url"
}

parse_args "$@"
main
