#!/usr/bin/env bash
#/ AI-powered file renaming and organization using Claude.
#/
#/ Scans a directory for files and directories, inspects media deeply for a
#/ clean descriptive name, groups related items into subdirectories, and
#/ renames files in place (default) or archives them to a dated directory.
#/
#/ Items Claude judges as active working files are left in place. Images are
#/ inspected with vision; unsupported or oversized media are converted,
#/ compressed, or reduced to a preview via this-to-that / ffmpeg before being
#/ sent to the API. Exact duplicate files are detected locally and moved to
#/ Trash after confirmation. When a filename appears descriptive enough,
#/ lightweight web hints are fetched from public search endpoints to improve
#/ naming and grouping.
#/
#/ History and rollback data are stored in a .tidy file in the target
#/ directory. Use "tidy revert" to undo renames.
#/
#/ Usage:
#/    tidy [options] [DIRECTORY]            Organize files (default: cwd)
#/    tidy revert [DATE] [DIRECTORY]        Revert renames
#/    tidy history [DIRECTORY]              Show the change log
#/    tidy status [DIRECTORY]               Show the skip list
#/    tidy schedule [SECONDS]               Install launchd agent for ~/Desktop
#/    tidy unschedule                       Remove launchd agent
#/
#/ Options:
#/    -h, --help           Print this help and exit
#/    -v, --verbose        Enable verbose output
#/    -n, --dry-run        Preview changes without applying them
#/    -y, --yes            Auto-approve changes (skip confirmation prompt)
#/    -r, --recursive      Recurse into subdirectories (each gets its own .tidy)
#/    -m, --model MODEL    Claude model (default: claude-sonnet-4-20250514)
#/        --min-age HOURS  Only process files older than HOURS hours
#/        --archive DIR    Archive files to DIR/YY-MM-DD/ instead of renaming
#/                         in place (e.g. --archive ~/Dropbox/backups/desktop)

set -Eeuo pipefail

source "$(dirname "$0")/../lib/bash/initrc"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)

verbose=0
dry_run=0
auto_approve=0
recursive=0
min_age_hours=0
lock_spec=""
model="claude-sonnet-4-20250514"
target_dir=""
archive_root=""
tidy_file=""
tmp_dir=""
subcmd=""
subcmd_args=()

files=()
file_sha1s=()
file_kinds=()
file_contexts=()
file_preview_paths=()
file_preview_media_types=()
file_preview_notes=()
related_hints=()
duplicate_of=()

cleanup() {
  if [[ -n ${lock_spec:-} ]]; then
    lock.release "$lock_spec"
  fi
  if [[ -n ${tmp_dir:-} && -d ${tmp_dir:-} ]]; then
    rm -rf -- "$tmp_dir"
  fi
  script.cleanup
}
trap cleanup SIGINT SIGTERM ERR EXIT

## ---------------------------------------------------------------------------
## CLI parsing
## ---------------------------------------------------------------------------

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      script.usage
      ;;
    -v | --verbose)
      verbose=1
      ;;
    -n | --dry-run)
      dry_run=1
      ;;
    -y | --yes)
      auto_approve=1
      ;;
    -r | --recursive)
      recursive=1
      ;;
    --min-age)
      shift
      if [[ $# -eq 0 ]]; then
        log.error "Missing value for --min-age"
        script.usage 1
      fi
      min_age_hours="$1"
      ;;
    --archive)
      shift
      if [[ $# -eq 0 ]]; then
        log.error "Missing value for --archive"
        script.usage 1
      fi
      archive_root="$1"
      ;;
    -m | --model)
      shift
      if [[ $# -eq 0 ]]; then
        log.error "Missing value for --model"
        script.usage 1
      fi
      model="$1"
      ;;
    --)
      shift
      break
      ;;
    --*)
      log.error "Unknown option: $1"
      script.usage 1
      ;;
    *)
      break
      ;;
    esac
    shift
  done

  # First positional: subcommand or directory.
  # Known subcommands are handled; anything else is treated as a directory.
  case "${1:-}" in
  "" | revert | history | status | schedule | unschedule)
    subcmd="${1:-}"
    if [[ -n $subcmd ]]; then
      shift
      subcmd_args=("$@")
    fi
    ;;
  *)
    # Not a subcommand — treat remaining args as target directory.
    target_dir="$1"
    shift
    if [[ $# -gt 0 ]]; then
      log.error "Unexpected arguments after directory: $*"
      script.usage 1
    fi
    ;;
  esac

  # Default target directory to cwd.
  if [[ -z $target_dir ]]; then
    # For subcommands that take a directory arg, pull it from subcmd_args.
    case "$subcmd" in
    "" )
      target_dir="$(pwd)"
      ;;
    revert)
      # revert DATE [DIRECTORY]
      if ((${#subcmd_args[@]} >= 2)); then
        target_dir="${subcmd_args[1]}"
      else
        target_dir="$(pwd)"
      fi
      ;;
    history | status)
      # history [DIRECTORY] / status [DIRECTORY]
      if ((${#subcmd_args[@]} >= 1)); then
        target_dir="${subcmd_args[0]}"
      else
        target_dir="$(pwd)"
      fi
      ;;
    esac
  fi

  # Resolve to absolute path.
  if [[ -n $target_dir ]]; then
    target_dir=$(cd "$target_dir" 2>/dev/null && pwd -P) || {
      log.error "Directory not found: $target_dir"
      return 1
    }
  fi

  # Set up the .tidy file path in the target directory.
  if [[ -n $target_dir ]]; then
    tidy_file="$target_dir/.tidy"
  fi
}

## ---------------------------------------------------------------------------
## Config helpers
## ---------------------------------------------------------------------------

today_tag() {
  date +%y-%m-%d
}

normalize_date_arg() {
  local input="$1"
  input="${input//-/}"
  if [[ ${#input} -eq 8 ]]; then
    # YYYYMMDD → YY-MM-DD
    printf '%s-%s-%s\n' "${input:2:2}" "${input:4:2}" "${input:6:2}"
  elif [[ ${#input} -eq 6 ]]; then
    # YYMMDD → YY-MM-DD
    printf '%s-%s-%s\n' "${input:0:2}" "${input:2:2}" "${input:4:2}"
  else
    log.error "Invalid date: $1 (expected YYYYMMDD, YYMMDD, YY-MM-DD, or YYYY-MM-DD)"
    return 1
  fi
}

## ---------------------------------------------------------------------------
## Skip list
## ---------------------------------------------------------------------------

skiplist_contains() {
  local sha1="$1"
  [[ -f $tidy_file ]] || return 1
  grep -q "\"type\":\"skip\".*\"sha1\":\"${sha1}\"" "$tidy_file" 2>/dev/null
}

skiplist_add() {
  local sha1="$1" filename="$2"
  if ! skiplist_contains "$sha1"; then
    printf '{"type":"skip","sha1":"%s","name":"%s"}\n' "$sha1" "$filename" >> "$tidy_file"
  fi
}

tidy_append_rename() {
  local date_tag="$1" mode="$2" original="$3" new_name="$4" group="$5" sha1="$6"
  local archive_dir="${7:-.}"
  local orig_json new_json group_json archive_json
  orig_json=$(jq -Rn --arg s "$original" '$s')
  new_json=$(jq -Rn --arg s "$new_name" '$s')
  group_json=$(jq -Rn --arg s "$group" '$s')
  archive_json=$(jq -Rn --arg s "$archive_dir" '$s')
  printf '{"type":"rename","date":"%s","mode":"%s","original":%s,"renamed":%s,"group":%s,"sha1":"%s","archive":%s}\n' \
    "$date_tag" "$mode" "$orig_json" "$new_json" "$group_json" "$sha1" "$archive_json" >> "$tidy_file"
}

file_sha1() {
  if [[ -d $1 ]]; then
    # Hash a sorted listing of immediate contents for directory identity.
    (cd "$1" && ls -1 2>/dev/null | sort | shasum | cut -d' ' -f1)
  else
    shasum "$1" | cut -d' ' -f1
  fi
}

## ---------------------------------------------------------------------------
## Media inspection helpers
## ---------------------------------------------------------------------------

MAX_VISION_BYTES=$((20 * 1024 * 1024)) # 20 MB cap for vision uploads
PREVIEW_VIDEO_SECONDS=24

vision_media_type() {
  local ext="${1##*.}"
  ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
  case "$ext" in
  jpg | jpeg) printf 'image/jpeg\n' ;;
  png) printf 'image/png\n' ;;
  gif) printf 'image/gif\n' ;;
  webp) printf 'image/webp\n' ;;
  *) return 1 ;;
  esac
}

file_ext() {
  local name="$1"
  local ext="${name##*.}"
  if [[ $ext == "$name" ]]; then
    printf '\n'
    return 0
  fi
  printf '%s\n' "$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
}

file_stem() {
  local name
  name=$(basename "$1")
  if [[ $name == *.* ]]; then
    printf '%s\n' "${name%.*}"
  else
    printf '%s\n' "$name"
  fi
}

is_image_ext() {
  case "$1" in
  jpg | jpeg | png | gif | webp | bmp | tif | tiff | heic | avif | svg) return 0 ;;
  *) return 1 ;;
  esac
}

is_video_ext() {
  case "$1" in
  mp4 | mov | mkv | webm | avi | m4v | mpg | mpeg | ts | m2ts) return 0 ;;
  *) return 1 ;;
  esac
}

is_audio_ext() {
  case "$1" in
  mp3 | aac | m4a | wav | flac | ogg | opus | wma | alac | aif | aiff) return 0 ;;
  *) return 1 ;;
  esac
}

is_document_preview_ext() {
  case "$1" in
  pdf) return 0 ;;
  *) return 1 ;;
  esac
}

is_archive_ext() {
  case "$1" in
  zip | tar | gz | tgz | bz2 | xz | rar | 7z | dmg | iso) return 0 ;;
  *) return 1 ;;
  esac
}

is_document_ext() {
  case "$1" in
  docx | doc | xlsx | xls | pptx | ppt | pages | numbers | key | txt | md | csv | rtf) return 0 ;;
  *) return 1 ;;
  esac
}

is_code_ext() {
  case "$1" in
  py | js | ts | jsx | tsx | swift | java | go | rb | sh | bash | zsh | c | cpp | h | hpp | rs | json | yaml | yml | xml | html | css | sql | toml) return 0 ;;
  *) return 1 ;;
  esac
}

is_font_ext() {
  case "$1" in
  ttf | otf | woff | woff2) return 0 ;;
  *) return 1 ;;
  esac
}

is_installer_ext() {
  case "$1" in
  pkg | msi | deb | rpm | app) return 0 ;;
  *) return 1 ;;
  esac
}

needs_image_conversion() {
  local ext
  ext=$(file_ext "$1")
  case "$ext" in
  heic | avif | bmp | tif | tiff | svg) return 0 ;;
  *) return 1 ;;
  esac
}

get_file_size() {
  wc -c < "$1" | tr -d '[:space:]'
}

ensure_tmp_dir() {
  if [[ -z $tmp_dir ]]; then
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/tidy.XXXXXX")
  fi
}

convert_for_vision() {
  local filepath="$1"
  local basename stem
  basename=$(basename "$filepath")
  stem=$(file_stem "$basename")

  ensure_tmp_dir
  local tmp_png="$tmp_dir/${stem}.png"

  "${script_dir}/this-to-that" "$filepath" "$tmp_png" || {
    log.warn "Failed to convert $basename to PNG for vision"
    return 1
  }

  printf '%s\n' "$tmp_png"
}

is_sendable_image() {
  local filepath="$1"
  vision_media_type "$filepath" >/dev/null 2>&1 || return 1
  local size
  size=$(get_file_size "$filepath")
  ((size > 0 && size <= MAX_VISION_BYTES))
}

optimize_image() {
  local filepath="$1"
  local ext
  ext=$(file_ext "$filepath")

  # Try cwebp for lossless-ish shrink (produces a webp the vision API accepts).
  if command -v cwebp >/dev/null 2>&1; then
    ensure_tmp_dir
    local tmp_webp="$tmp_dir/$(file_stem "$filepath")-opt.webp"
    if cwebp -q 70 -resize 1600 0 "$filepath" -o "$tmp_webp" >/dev/null 2>&1 \
       && [[ -f $tmp_webp ]] && (($(get_file_size "$tmp_webp") <= MAX_VISION_BYTES)); then
      printf '%s\n' "$tmp_webp"
      return 0
    fi
  fi

  # Try imageoptim-cli for in-place optimization (copy first).
  if command -v imageoptim >/dev/null 2>&1; then
    ensure_tmp_dir
    local tmp_opt="$tmp_dir/$(basename "$filepath")"
    cp -- "$filepath" "$tmp_opt"
    if imageoptim "$tmp_opt" >/dev/null 2>&1 \
       && [[ -f $tmp_opt ]] && (($(get_file_size "$tmp_opt") <= MAX_VISION_BYTES)); then
      printf '%s\n' "$tmp_opt"
      return 0
    fi
  fi

  return 1
}

compress_image_for_vision() {
  local filepath="$1"

  local basename stem
  basename=$(basename "$filepath")
  stem=$(file_stem "$basename")

  # First try lightweight optimizers (cwebp / imageoptim).
  local optimized
  if optimized=$(optimize_image "$filepath") && [[ -n $optimized ]]; then
    printf '%s\n' "$optimized"
    return 0
  fi

  # Fall back to ffmpeg-based resize via this-to-that.
  ensure_tmp_dir
  local tmp_jpg="$tmp_dir/${stem}-vision.jpg"
  local tmp_small="$tmp_dir/${stem}-vision-small.jpg"

  "${script_dir}/this-to-that" "$filepath" "$tmp_jpg" \
    -- -vf "scale='min(1600,iw)':-2:force_original_aspect_ratio=decrease" -q:v 4 \
    >/dev/null 2>&1 || return 1

  if [[ ! -f $tmp_jpg ]]; then
    return 1
  fi

  if (($(get_file_size "$tmp_jpg") > MAX_VISION_BYTES)); then
    "${script_dir}/this-to-that" "$filepath" "$tmp_small" \
      -- -vf "scale='min(1100,iw)':-2:force_original_aspect_ratio=decrease" -q:v 8 \
      >/dev/null 2>&1 || return 1
    tmp_jpg="$tmp_small"
  fi

  if [[ -f $tmp_jpg ]] && (($(get_file_size "$tmp_jpg") <= MAX_VISION_BYTES)); then
    printf '%s\n' "$tmp_jpg"
    return 0
  fi

  return 1
}

generate_video_preview() {
  local filepath="$1"

  local basename stem
  basename=$(basename "$filepath")
  stem=$(file_stem "$basename")

  ensure_tmp_dir
  local tmp_png="$tmp_dir/${stem}-video-preview.png"

  "${script_dir}/this-to-that" "$filepath" "$tmp_png" \
    -- -ss 0 -t "$PREVIEW_VIDEO_SECONDS" \
    -vf "fps=1/6,scale=640:-2:force_original_aspect_ratio=decrease,tile=2x2" \
    -frames:v 1 \
    >/dev/null 2>&1 || return 1

  [[ -f $tmp_png ]] || return 1
  printf '%s\n' "$tmp_png"
}

generate_audio_preview() {
  local filepath="$1"

  local basename stem
  basename=$(basename "$filepath")
  stem=$(file_stem "$basename")

  ensure_tmp_dir
  local tmp_png="$tmp_dir/${stem}-audio-preview.png"

  "${script_dir}/this-to-that" "$filepath" "$tmp_png" \
    -- -lavfi "showspectrumpic=s=1280x720:legend=disabled" \
    -frames:v 1 \
    >/dev/null 2>&1 || return 1

  [[ -f $tmp_png ]] || return 1
  printf '%s\n' "$tmp_png"
}

generate_document_preview() {
  local filepath="$1"
  local ext
  ext=$(file_ext "$filepath")
  is_document_preview_ext "$ext" || return 1
  convert_for_vision "$filepath"
}

resolve_vision_asset() {
  local filepath="$1"
  local filename kind
  filename=$(basename "$filepath")
  kind="${2:-file}"

  local preview_file="" note=""

  if is_sendable_image "$filepath"; then
    local fsize
    fsize=$(get_file_size "$filepath")
    if ((fsize > 512 * 1024)); then
      ((verbose)) && log.info "Shrinking large image for vision: $filename"
      local shrunk
      if shrunk=$(compress_image_for_vision "$filepath") && [[ -n $shrunk ]]; then
        printf '%s\t%s\t%s\n' "$shrunk" "$(vision_media_type "$shrunk")" "Compressed image preview"
        return 0
      fi
    fi
    printf '%s\t%s\t%s\n' "$filepath" "$(vision_media_type "$filepath")" "Direct image preview"
    return 0
  fi

  case "$kind" in
  image)
    if needs_image_conversion "$filepath"; then
      ((verbose)) && log.info "Converting $filename to PNG for vision"
      preview_file=$(convert_for_vision "$filepath") || return 1
      note="Converted unsupported image to PNG for inspection"
    elif vision_media_type "$filepath" >/dev/null 2>&1; then
      preview_file=$(compress_image_for_vision "$filepath") || return 1
      note="Compressed image preview for inspection"
    fi
    ;;
  video)
    ((verbose)) && log.info "Generating video contact sheet for: $filename"
    preview_file=$(generate_video_preview "$filepath") || return 1
    note="Contact sheet sampled from the first ${PREVIEW_VIDEO_SECONDS} seconds"
    ;;
  audio)
    ((verbose)) && log.info "Generating audio spectrogram for: $filename"
    preview_file=$(generate_audio_preview "$filepath") || return 1
    note="Spectrogram preview derived from the audio"
    ;;
  document)
    ((verbose)) && log.info "Rendering document preview for: $filename"
    preview_file=$(generate_document_preview "$filepath") || return 1
    note="Preview rendered from the first page of the document"
    ;;
  esac

  if [[ -n $preview_file && -f $preview_file ]]; then
    if (($(get_file_size "$preview_file") > MAX_VISION_BYTES)); then
      preview_file=$(compress_image_for_vision "$preview_file") || return 1
      note="${note}; compressed for upload"
    fi

    if [[ -n $preview_file ]] && vision_media_type "$preview_file" >/dev/null 2>&1; then
      printf '%s\t%s\t%s\n' "$preview_file" "$(vision_media_type "$preview_file")" "$note"
      return 0
    fi
  fi

  return 1
}

inspect_file_kind() {
  local filepath="$1"
  if [[ -d $filepath ]]; then
    printf 'directory\n'
    return 0
  fi

  local ext
  ext=$(file_ext "$filepath")
  if is_image_ext "$ext"; then
    printf 'image\n'
  elif is_video_ext "$ext"; then
    printf 'video\n'
  elif is_audio_ext "$ext"; then
    printf 'audio\n'
  elif is_document_preview_ext "$ext"; then
    printf 'document\n'
  elif is_archive_ext "$ext"; then
    printf 'archive\n'
  elif is_document_ext "$ext"; then
    printf 'document\n'
  elif is_code_ext "$ext"; then
    printf 'code\n'
  elif is_font_ext "$ext"; then
    printf 'font\n'
  elif is_installer_ext "$ext"; then
    printf 'installer\n'
  else
    printf 'file\n'
  fi
}

format_duration_for_prompt() {
  local duration="${1:-}"
  [[ -n $duration ]] || return 0
  awk -v d="$duration" 'BEGIN {
    if (d <= 0) exit
    if (d < 60) {
      printf "%.1fs\n", d
      exit
    }
    minutes = int(d / 60)
    seconds = int(d) % 60
    if (minutes < 60) {
      printf "%dm%02ds\n", minutes, seconds
      exit
    }
    hours = int(minutes / 60)
    minutes = minutes % 60
    printf "%dh%02dm%02ds\n", hours, minutes, seconds
  }'
}

ffprobe_summary() {
  local filepath="$1"
  command -v ffprobe >/dev/null 2>&1 || return 1

  local video_dims video_codec audio_codec duration format_name
  video_dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$filepath" 2>/dev/null | head -n 1 || true)
  video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$filepath" 2>/dev/null | head -n 1 || true)
  audio_codec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$filepath" 2>/dev/null | head -n 1 || true)
  duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$filepath" 2>/dev/null | head -n 1 || true)
  format_name=$(ffprobe -v error -show_entries format=format_name -of default=noprint_wrappers=1:nokey=1 "$filepath" 2>/dev/null | head -n 1 || true)

  local -a parts=()
  [[ -n $format_name ]] && parts+=("format ${format_name%%,*}")
  [[ -n $video_dims ]] && parts+=("$video_dims")
  [[ -n $video_codec ]] && parts+=("video $video_codec")
  [[ -n $audio_codec ]] && parts+=("audio $audio_codec")
  if [[ -n $duration ]]; then
    local pretty_duration
    pretty_duration=$(format_duration_for_prompt "$duration")
    [[ -n $pretty_duration ]] && parts+=("duration $pretty_duration")
  fi

  ((${#parts[@]} > 0)) || return 1
  local joined=""
  printf -v joined '%s, ' "${parts[@]}"
  joined="${joined%, }"
  printf '%s\n' "$joined"
}

mdls_summary() {
  local filepath="$1"
  command -v mdls >/dev/null 2>&1 || return 1

  local kind pixel_width pixel_height page_count
  kind=$(mdls -raw -name kMDItemKind "$filepath" 2>/dev/null || true)
  pixel_width=$(mdls -raw -name kMDItemPixelWidth "$filepath" 2>/dev/null || true)
  pixel_height=$(mdls -raw -name kMDItemPixelHeight "$filepath" 2>/dev/null || true)
  page_count=$(mdls -raw -name kMDItemNumberOfPages "$filepath" 2>/dev/null || true)

  local -a parts=()
  [[ -n $kind && $kind != "(null)" ]] && parts+=("$kind")
  if [[ -n $pixel_width && -n $pixel_height && $pixel_width != "(null)" && $pixel_height != "(null)" ]]; then
    parts+=("${pixel_width}x${pixel_height}")
  fi
  [[ -n $page_count && $page_count != "(null)" ]] && parts+=("${page_count} page(s)")

  ((${#parts[@]} > 0)) || return 1
  local joined=""
  printf -v joined '%s, ' "${parts[@]}"
  joined="${joined%, }"
  printf '%s\n' "$joined"
}

file_metadata_summary() {
  local filepath="$1"
  ffprobe_summary "$filepath" 2>/dev/null || mdls_summary "$filepath" 2>/dev/null || true
}

generic_filename_stem() {
  local stem
  stem=$(file_stem "$1" | tr '[:upper:]' '[:lower:]')
  printf '%s\n' "$stem" | sed -E 's/[[:space:]_.-]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//'
}

is_generic_filename() {
  local stem
  stem=$(generic_filename_stem "$1")
  case "$stem" in
  img* | dsc* | pxl* | mvimg* | vid* | mov* | scan* | screenshot* | "screen shot"* | document* | image* | photo* | file* | export* | untitled* | whatsapp* | telegram* | signal* | received* | *_copy | *" copy")
    return 0
    ;;
  esac
  [[ $stem =~ ^[a-z]*[0-9_-]+$ ]]
}

filename_quality_score() {
  local stem alpha_count word_count score
  stem=$(generic_filename_stem "$1")
  alpha_count=$(printf '%s' "$stem" | tr -cd '[:alpha:]' | wc -c | tr -d '[:space:]')
  word_count=$(printf '%s' "$stem" | tr ' ' '\n' | awk 'length($0) >= 3' | wc -l | tr -d '[:space:]')
  score=$((alpha_count + (word_count * 8)))
  if is_generic_filename "$1"; then
    score=$((score - 40))
  fi
  if [[ -n $stem && -z ${stem//[0-9 _-]/} ]]; then
    score=$((score - 20))
  fi
  printf '%s\n' "$score"
}

search_query_for_filename() {
  local stem
  stem=$(generic_filename_stem "$1")
  printf '%s\n' "$stem" | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//'
}

should_search_filename_context() {
  local query
  query=$(search_query_for_filename "$1")
  [[ ${#query} -ge 8 ]] || return 1
  is_generic_filename "$1" && return 1
  [[ $query =~ [[:alpha:]]{4,} ]]
}

search_filename_context() {
  local filename="$1"
  should_search_filename_context "$filename" || return 0

  local query
  query=$(search_query_for_filename "$filename")
  [[ -n $query ]] || return 0

  local wiki_json suggest_json
  local -a hints=()

  wiki_json=$(curl -fsSL --max-time 4 --get \
    --data-urlencode "search=$query" \
    --data "action=opensearch" \
    --data "limit=1" \
    --data "format=json" \
    "https://en.wikipedia.org/w/api.php" 2>/dev/null || true)

  if [[ -n $wiki_json ]]; then
    local wiki_title wiki_url
    wiki_title=$(printf '%s' "$wiki_json" | jq -r '.[1][0] // empty' 2>/dev/null || true)
    wiki_url=$(printf '%s' "$wiki_json" | jq -r '.[3][0] // empty' 2>/dev/null || true)
    if [[ -n $wiki_title ]]; then
      if [[ -n $wiki_url ]]; then
        hints+=("Wikipedia: ${wiki_title} (${wiki_url})")
      else
        hints+=("Wikipedia: ${wiki_title}")
      fi
    fi
  fi

  suggest_json=$(curl -fsSL --max-time 4 --get \
    --data-urlencode "q=$query" \
    --data "client=firefox" \
    "https://suggestqueries.google.com/complete/search" 2>/dev/null || true)

  if [[ -n $suggest_json ]]; then
    local suggestions suggestion_count=0 suggestion
    suggestions=$(printf '%s' "$suggest_json" | jq -r '.[1][]? // empty' 2>/dev/null || true)
    while IFS= read -r suggestion; do
      [[ -n $suggestion ]] || continue
      hints+=("Web suggestion: $suggestion")
      suggestion_count=$((suggestion_count + 1))
      ((suggestion_count >= 2)) && break
    done <<<"$suggestions"
  fi

  ((${#hints[@]} > 0)) || return 0
  local joined=""
  printf -v joined '%s; ' "${hints[@]}"
  joined="${joined%; }"
  printf '%s\n' "$joined"
}

compact_name_key() {
  local stem
  stem=$(generic_filename_stem "$1")
  stem=$(printf '%s' "$stem" | sed -E 's/(^| )(copy|edited|final|draft)( [0-9]+)?$//; s/[^a-z0-9]+//g')
  printf '%s\n' "$stem"
}

shared_token_count() {
  local left="$1" right="$2"
  local left_tokens right_tokens
  left_tokens=$(generic_filename_stem "$left" | tr ' ' '\n' | awk 'length($0) >= 3 && $0 !~ /^[0-9]+$/')
  right_tokens=$(generic_filename_stem "$right" | tr ' ' '\n' | awk 'length($0) >= 3 && $0 !~ /^[0-9]+$/')

  local count=0 token other
  while IFS= read -r token; do
    [[ -n $token ]] || continue
    while IFS= read -r other; do
      [[ -n $other ]] || continue
      if [[ $token == "$other" ]]; then
        count=$((count + 1))
        break
      fi
    done <<<"$right_tokens"
  done <<<"$left_tokens"
  printf '%s\n' "$count"
}

names_look_related() {
  local left="$1" right="$2"
  local left_key right_key shared

  left_key=$(compact_name_key "$left")
  right_key=$(compact_name_key "$right")

  if [[ -n $left_key && -n $right_key ]]; then
    if [[ $left_key == "$right_key" ]]; then
      return 0
    fi
    if (( ${#left_key} >= 6 && ${#right_key} >= 6 )); then
      if [[ $left_key == ${right_key}* || $right_key == ${left_key}* ]]; then
        return 0
      fi
    fi
  fi

  shared=$(shared_token_count "$left" "$right")
  ((shared >= 2))
}

file_index_by_name() {
  local target="$1"
  local i
  for ((i = 0; i < ${#files[@]}; i++)); do
    if [[ ${files[$i]} == "$target" ]]; then
      printf '%s\n' "$i"
      return 0
    fi
  done
  return 1
}

detect_duplicate_files() {
  local i j
  for ((i = 0; i < ${#files[@]}; i++)); do
    duplicate_of[$i]=""
  done

  for ((i = 0; i < ${#files[@]}; i++)); do
    [[ -f "$target_dir/${files[$i]}" ]] || continue
    [[ -n ${duplicate_of[$i]:-} ]] && continue

    local -a same_indices=("$i")
    for ((j = i + 1; j < ${#files[@]}; j++)); do
      [[ -f "$target_dir/${files[$j]}" ]] || continue
      [[ ${file_sha1s[$i]} == "${file_sha1s[$j]}" ]] || continue
      same_indices+=("$j")
    done

    ((${#same_indices[@]} > 1)) || continue

    local keeper_idx="${same_indices[0]}"
    local keeper_score candidate candidate_score
    keeper_score=$(filename_quality_score "${files[$keeper_idx]}")

    for candidate in "${same_indices[@]:1}"; do
      candidate_score=$(filename_quality_score "${files[$candidate]}")
      if ((candidate_score > keeper_score)); then
        keeper_idx="$candidate"
        keeper_score="$candidate_score"
      fi
    done

    for candidate in "${same_indices[@]}"; do
      if ((candidate != keeper_idx)); then
        duplicate_of[$candidate]="${files[$keeper_idx]}"
      fi
    done
  done
}

build_related_hints() {
  local i j
  for ((i = 0; i < ${#files[@]}; i++)); do
    related_hints[$i]=""
  done

  for ((i = 0; i < ${#files[@]}; i++)); do
    [[ -n ${duplicate_of[$i]:-} ]] && continue

    local related="" related_count=0
    for ((j = 0; j < ${#files[@]}; j++)); do
      ((i == j)) && continue
      [[ -n ${duplicate_of[$j]:-} ]] && continue
      names_look_related "${files[$i]}" "${files[$j]}" || continue
      if [[ -z $related ]]; then
        related="${files[$j]}"
      else
        related+=", ${files[$j]}"
      fi
      related_count=$((related_count + 1))
      ((related_count >= 4)) && break
    done
    related_hints[$i]="$related"
  done
}

archive_listing() {
  local filepath="$1"
  local ext
  ext=$(file_ext "$filepath")
  case "$ext" in
  zip) zipinfo -1 "$filepath" 2>/dev/null | head -20 ;;
  tar) tar tf "$filepath" 2>/dev/null | head -20 ;;
  gz | tgz) tar tzf "$filepath" 2>/dev/null | head -20 ;;
  bz2) tar tjf "$filepath" 2>/dev/null | head -20 ;;
  xz) tar tJf "$filepath" 2>/dev/null | head -20 ;;
  esac
}

download_source_url() {
  local filepath="$1"
  local url
  url=$(mdls -raw -name kMDItemWhereFroms "$filepath" 2>/dev/null | head -1 || true)
  url=${url#\(}
  url=$(printf '%s' "$url" | sed 's/^[[:space:]]*"//;s/".*$//' 2>/dev/null || true)
  [[ $url != "(null)" && $url != "null" && -n $url ]] && printf '%s\n' "$url"
}

build_context_for_index() {
  local idx="$1"
  local filename="${files[$idx]}"
  local filepath="$target_dir/$filename"
  local kind="${file_kinds[$idx]}"

  if [[ $kind == directory ]]; then
    local item_count listing text
    item_count=$(ls -1 "$filepath" 2>/dev/null | wc -l | tr -d '[:space:]')
    listing=$(ls -1 "$filepath" 2>/dev/null | head -30)
    text="Directory: ${filename}/ (${item_count} items)"
    if [[ -n $listing ]]; then
      text+=$'\n\n'"Contents:"$'\n'"${listing}"
    fi
    if ((item_count > 30)); then
      text+=$'\n'"... (${item_count} items total)"
    fi
    printf '%s\n' "$text"
    return 0
  fi

  local ext file_size metadata web_hints text
  ext=$(file_ext "$filename")
  file_size=$(get_file_size "$filepath")
  metadata=$(file_metadata_summary "$filepath")
  web_hints=$(search_filename_context "$filename")

  local download_url
  download_url=$(download_source_url "$filepath")

  text="Filename: ${filename}"
  text+=$'\n'"Type: ${kind}"
  if [[ -n $ext ]]; then
    text+=$'\n'"Extension: .${ext}"
  fi
  text+=$'\n'"Size: ${file_size} bytes"
  [[ -n $metadata ]] && text+=$'\n'"Metadata: ${metadata}"
  [[ -n ${file_preview_notes[$idx]:-} ]] && text+=$'\n'"Preview source: ${file_preview_notes[$idx]}"
  [[ -n ${related_hints[$idx]:-} ]] && text+=$'\n'"Possibly related files in directory: ${related_hints[$idx]}"
  [[ -n $web_hints ]] && text+=$'\n'"Internet hints: ${web_hints}"
  [[ -n $download_url ]] && text+=$'\n'"Download source: ${download_url}"

  if [[ $kind == archive ]]; then
    local listing
    listing=$(archive_listing "$filepath")
    if [[ -n $listing ]]; then
      text+=$'\n\n'"Archive contents:"$'\n'"${listing}"
    fi
  fi

  printf '%s\n' "$text"
}

batch_compress_previews() {
  # Batch-compress all vision-eligible images in one cwebp sweep.
  # Populates file_preview_paths/media_types/notes for images that succeed.
  # Returns the indices that were NOT handled (need individual resolve).
  ensure_tmp_dir
  local i filepath kind ext
  local -a cwebp_indices=() cwebp_srcs=() cwebp_dsts=()
  local -a remaining=()

  for ((i = 0; i < ${#files[@]}; i++)); do
    [[ -z ${duplicate_of[$i]:-} ]] || continue
    filepath="$target_dir/${files[$i]}"
    kind="${file_kinds[$i]}"
    [[ $kind != directory ]] || continue

    ext=$(file_ext "${files[$i]}")
    if is_image_ext "$ext" && command -v cwebp >/dev/null 2>&1; then
      local dst="$tmp_dir/$(file_stem "${files[$i]}")-preview.webp"
      cwebp_indices+=("$i")
      cwebp_srcs+=("$filepath")
      cwebp_dsts+=("$dst")
    else
      remaining+=("$i")
    fi
  done

  # Run cwebp in parallel for all images (up to 8 at a time).
  if ((${#cwebp_indices[@]} > 0)); then
    ((verbose)) && log.info "Batch-compressing ${#cwebp_indices[@]} image(s) for preview"
    local j pids=() batch_limit=8
    for ((j = 0; j < ${#cwebp_indices[@]}; j++)); do
      cwebp -q 50 -resize 1200 0 "${cwebp_srcs[$j]}" -o "${cwebp_dsts[$j]}" \
        >/dev/null 2>&1 &
      pids+=($!)
      if (( ${#pids[@]} >= batch_limit )); then
        wait "${pids[@]}" 2>/dev/null || true
        pids=()
      fi
    done
    ((${#pids[@]} > 0)) && { wait "${pids[@]}" 2>/dev/null || true; }

    for ((j = 0; j < ${#cwebp_indices[@]}; j++)); do
      local idx="${cwebp_indices[$j]}"
      if [[ -f ${cwebp_dsts[$j]} ]] && (($(get_file_size "${cwebp_dsts[$j]}") <= MAX_VISION_BYTES)); then
        file_preview_paths[$idx]="${cwebp_dsts[$j]}"
        file_preview_media_types[$idx]="image/webp"
        file_preview_notes[$idx]="Batch-compressed image preview"
      else
        # cwebp failed or too large — fall back to individual resolve.
        remaining+=("$idx")
      fi
    done
  fi

  printf '%s\n' "${remaining[@]}"
}

precompute_file_context() {
  local i
  for ((i = 0; i < ${#files[@]}; i++)); do
    local filepath="$target_dir/${files[$i]}"
    file_kinds[$i]=$(inspect_file_kind "$filepath")
    file_preview_paths[$i]=""
    file_preview_media_types[$i]=""
    file_preview_notes[$i]=""
    file_contexts[$i]=""
  done

  detect_duplicate_files
  build_related_hints

  # Batch-compress images first, then handle remaining files individually.
  local -a remaining_indices=()
  while IFS= read -r idx; do
    [[ -n $idx ]] || continue
    remaining_indices+=("$idx")
  done < <(batch_compress_previews)

  for i in "${remaining_indices[@]}"; do
    local filepath="$target_dir/${files[$i]}"
    if [[ -z ${duplicate_of[$i]:-} && ${file_kinds[$i]} != directory ]]; then
      local asset_info preview_path preview_media preview_note
      asset_info=$(resolve_vision_asset "$filepath" "${file_kinds[$i]}" 2>/dev/null || true)
      if [[ -n $asset_info ]]; then
        IFS=$'\t' read -r preview_path preview_media preview_note <<<"$asset_info"
        file_preview_paths[$i]="$preview_path"
        file_preview_media_types[$i]="$preview_media"
        file_preview_notes[$i]="$preview_note"
      fi
    fi
  done

  for ((i = 0; i < ${#files[@]}; i++)); do
    file_contexts[$i]=$(build_context_for_index "$i")
  done
}

## ---------------------------------------------------------------------------
## Claude API — Phase 1: individual file naming (with vision)
## ---------------------------------------------------------------------------

BATCH_SIZE=20

NAME_SYSTEM_PROMPT="You are a file/directory renamer. You receive a filename or \
directory name plus any available context: metadata, sibling-file hints, web \
hints, and sometimes a derived visual preview (image thumbnail, video frame, \
document page, or waveform).

Respond with ONLY a JSON object — no markdown fences, no prose:
{\"name\": \"suggested-name\"}

## Formatting
- Lowercase. Hyphens as separators (no spaces, underscores, or camelCase).
- Preserve the original file extension exactly. Directories get no extension.
- Target 2–5 words. Never exceed 60 characters (excluding extension).
- Strip leading/trailing hyphens and collapse consecutive hyphens.

## Naming strategy (highest to lowest priority)
1. If a visual preview is provided, name what you see — subject, scene, or \
content — not the medium (not \"photo-of-cat\" → \"orange-tabby-on-couch\").
2. Use metadata (title, author, album, EXIF, PDF title) when it adds specificity.
3. Use sibling-file and web hints to disambiguate or add context.
4. Fall back to the original name, cleaned up, only when no better signal exists.

## Content rules
- Prefer concrete nouns and adjectives over generic words like image, photo, \
screenshot, video, file, document, export, untitled, copy, final.
- Keep meaningful dates that identify the content (e.g. \"q3-2024-earnings\"). \
Remove noise dates that are just creation timestamps (e.g. \"20240315-143022\").
- Keep version markers or sequence numbers only when they distinguish files in \
a set (e.g. \"logo-v2\", \"lecture-03\"). Strip standalone \"(1)\" or \"-copy\" noise.
- For directories: name describes the collection, not a single item inside it.

## Preservation rules
- If the existing name is already clean, specific, and follows formatting rules, \
return it unchanged.
- Never alter the file extension, even if it looks wrong.
- Preserve language — if the original name is in French, keep the rename in French."

BATCH_NAME_SYSTEM_PROMPT="You are a file/directory renamer. You receive a JSON \
array of objects, each with an \"id\" and text context about a file or directory.

Respond with ONLY a JSON array — no markdown fences, no prose. Every input \
object MUST appear in the output with its original \"id\":
[{\"id\": 0, \"name\": \"suggested-name\"}, ...]

## Formatting
- Lowercase. Hyphens as separators (no spaces, underscores, or camelCase).
- Preserve the original file extension exactly. Directories get no extension.
- Target 2–5 words. Never exceed 60 characters (excluding extension).
- Strip leading/trailing hyphens and collapse consecutive hyphens.

## Naming strategy (highest to lowest priority)
1. Use metadata (title, author, album, EXIF, PDF title) when it adds specificity.
2. Use sibling-file and web hints to disambiguate or add context.
3. Fall back to the original name, cleaned up, only when no better signal exists.

## Content rules
- Prefer concrete nouns and adjectives over generic words like image, photo, \
screenshot, video, file, document, export, untitled, copy, final.
- Keep meaningful dates that identify the content (e.g. \"q3-2024-earnings\"). \
Remove noise dates that are just creation timestamps (e.g. \"20240315-143022\").
- Keep version markers or sequence numbers only when they distinguish files in \
a set (e.g. \"logo-v2\", \"lecture-03\"). Strip standalone \"(1)\" or \"-copy\" noise.
- For directories: name describes the collection, not a single item inside it.

## Batch-specific rules
- Deduplicate: if two items would get the same name, append a minimal \
distinguishing suffix (e.g. \"-front\", \"-back\", \"-01\", \"-02\").
- Sibling awareness: use the full batch as context. If items clearly belong to \
a series, use consistent naming (\"trip-rome-01\", \"trip-rome-02\" not \
\"colosseum\", \"trevi-fountain\").

## Preservation rules
- If the existing name is already clean, specific, and follows formatting rules, \
return it unchanged.
- Never alter the file extension, even if it looks wrong.
- Preserve language — if the original name is in French, keep the rename in French."

suggest_name_for_index() {
  local idx="$1"
  local filename="${files[$idx]}"
  local user_text payload

  user_text="${file_contexts[$idx]}"

  if [[ -n ${file_preview_paths[$idx]:-} && -n ${file_preview_media_types[$idx]:-} ]]; then
    ((verbose)) && log.info "Sending visual content for: $filename"
    local base64_data
    base64_data=$(base64 < "${file_preview_paths[$idx]}" | tr -d '\n')
    payload=$(ai.anthropic_vision_payload "$model" "$NAME_SYSTEM_PROMPT" "$user_text" "${file_preview_media_types[$idx]}" "$base64_data" 256)
  else
    payload=$(ai.anthropic_chat_payload "$model" "$NAME_SYSTEM_PROMPT" "$user_text" 256)
  fi

  local resp
  ai.anthropic_messages resp "$payload" || {
    ai.anthropic_log_error resp "Failed to get suggestion for: $filename"
    return 1
  }

  if ! http.response_ok resp; then
    ai.anthropic_log_error resp "API error for: $filename"
    return 1
  fi

  local raw
  raw=$(ai.anthropic_message_text resp) || {
    log.error "Failed to parse response for: $filename"
    return 1
  }

  # Strip markdown fences if Claude wrapped the JSON.
  raw="${raw#\`\`\`json}"
  raw="${raw#\`\`\`}"
  raw="${raw%\`\`\`}"

  local name
  name=$(printf '%s' "$raw" | jq -er '.name // empty' 2>/dev/null) || {
    log.error "Invalid JSON response for: $filename"
    ((verbose)) && log.error "Raw: $raw"
    return 1
  }

  # Trim whitespace.
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"

  printf '%s\n' "$name"
}

suggest_names_batch() {
  # Accepts a list of file indices (text-only, no vision) and returns
  # suggested names via a single API call. Results are written into
  # the suggested_names array (declared by the caller).
  local -a batch_indices=("$@")
  ((${#batch_indices[@]} > 0)) || return 0

  # Build a JSON array of {id, context} objects.
  local batch_json="[" first=1
  local idx context_json
  for idx in "${batch_indices[@]}"; do
    context_json=$(json.escape "${file_contexts[$idx]}")
    if ((first)); then
      first=0
    else
      batch_json+=","
    fi
    batch_json+="{\"id\":$idx,\"context\":\"$context_json\"}"
  done
  batch_json+="]"

  local max_tokens=$(( ${#batch_indices[@]} * 200 ))
  ((max_tokens < 1024)) && max_tokens=1024
  ((max_tokens > 4096)) && max_tokens=4096

  local user_text="Files to rename:
${batch_json}"

  local payload
  payload=$(ai.anthropic_chat_payload "$model" "$BATCH_NAME_SYSTEM_PROMPT" "$user_text" "$max_tokens")

  local resp
  ai.anthropic_messages resp "$payload" || {
    ai.anthropic_log_error resp "Failed to get batch name suggestions"
    return 1
  }

  if ! http.response_ok resp; then
    ai.anthropic_log_error resp "API error for batch name suggestions"
    return 1
  fi

  local raw
  raw=$(ai.anthropic_message_text resp) || {
    log.error "Failed to parse batch naming response"
    return 1
  }

  # Strip markdown fences.
  raw="${raw#\`\`\`json}"
  raw="${raw#\`\`\`}"
  raw="${raw%\`\`\`}"

  # Parse each result by id.
  local count
  count=$(printf '%s' "$raw" | jq -r 'length' 2>/dev/null) || {
    log.error "Invalid batch naming response"
    ((verbose)) && log.error "Raw: $raw"
    return 1
  }

  local j file_id name
  for ((j = 0; j < count; j++)); do
    file_id=$(printf '%s' "$raw" | jq -r ".[$j].id // empty" 2>/dev/null)
    name=$(printf '%s' "$raw" | jq -er ".[$j].name // empty" 2>/dev/null) || continue
    [[ -n $file_id && -n $name ]] || continue
    # Trim whitespace.
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    suggested_names[$file_id]="$name"
  done
}

## ---------------------------------------------------------------------------
## Claude API — Phase 2: batch grouping + skip detection
## ---------------------------------------------------------------------------

ORGANIZE_SYSTEM_PROMPT="You organize a batch of files and directories that are \
about to be renamed and moved. You receive a JSON array of objects, each with:
- \"id\" (required): unique identifier, copy exactly to output
- \"original\" (required): current filename or directory name (trailing / = directory)
- \"suggested\" (required): a pre-suggested rename (may be null)
- \"kind\" (optional): MIME type or file category
- \"context\" (optional): metadata, preview description, or content summary
- \"related\" (optional): hints about sibling files or parent directory

Respond with ONLY a JSON object — no markdown fences, no prose:
{
  \"summary\": \"short human-readable description of what was organized\",
  \"groups\": [
    {\"name\": \"dogs\", \"reason\": \"4 photos of the same dog\"}
  ],
  \"files\": [
    {\"id\": 0, \"name\": \"clean.pdf\", \"group\": null, \"skip\": false},
    {\"id\": 1, \"name\": \"sitting.png\", \"group\": \"dogs\", \"skip\": false},
    {\"id\": 2, \"name\": null, \"group\": null, \"skip\": true}
  ]
}

CRITICAL: Every input object MUST appear exactly once in the output \"files\" \
array with its original \"id\". Missing or duplicated ids are errors.

─── GROUPING ───

When to group:
- 3+ files share a clear thematic, project, or temporal relationship → group.
- 2 files may be grouped only when the relationship is unambiguous (e.g. a \
document and its signature, a RAW and its JPEG, front and back of the same thing).
- A single file is NEVER placed in a group by itself.

Group naming:
- Short, lowercase, hyphenated. Describes the collection, not one member.
- Aim for the most specific accurate label: \"hawaii-2024\" not \"vacation\", \
\"tax-returns\" not \"documents\", \"headshots\" not \"photos\".
- NEVER reuse the parent directory name. The files are already there.
- NEVER use generic catch-all groups like \"misc\", \"other\", \"unsorted\", \
\"general\". If files don't cluster, they stay ungrouped (null).
- If a natural hierarchy exists (e.g. a project with assets/ and docs/), \
you may use one level of nesting with a slash: \"project-x/assets\". \
Limit to two levels max.

Group cohesion:
- Every file in a group should belong. Don't force stragglers into the \
nearest group — leave them ungrouped.
- If a potential group would contain files that only loosely relate (e.g. \
\"things from 2024\"), it's too broad. Find a tighter cluster or skip grouping.
- Prefer fewer, tighter groups over many sparse ones.

The \"groups\" array:
- List every group used in \"files\", with a short \"reason\" explaining why \
these files were clustered. This is for human review, not the filesystem.

─── SKIPPING ───

Set skip: true (with name: null, group: null) for:
- Active working files: READMEs, TODOs, CHANGELOG, scratch notes, drafts \
with recent modification context, anything described as \"in progress\".
- Config and dotfiles: .gitignore, .env*, .eslintrc, tsconfig.json, \
Makefile, Dockerfile, package.json, etc.
- System/hidden files: .DS_Store, Thumbs.db, desktop.ini, __MACOSX/.
- Files explicitly described as pinned, starred, or manually organized.

Do NOT skip:
- Old downloads, accumulated clutter, duplicates, or files with auto-generated \
names — these are the prime targets for organizing.
- Files that merely look important. A file named \"final-report.pdf\" among \
a pile of clutter is still clutter unless context says otherwise.
- When in doubt, rename. Only skip when you have positive evidence the file \
is actively maintained or intentionally placed.

─── NAMING ───

Starting point:
- Use the \"suggested\" name if it is already good.
- Improve it when you have additional context the namer didn't (e.g. group \
membership reveals the subject more clearly).
- If \"suggested\" is null, generate a name following the same rules.

Formatting:
- Lowercase, hyphens as separators. No spaces, underscores, or camelCase.
- Preserve original file extension exactly (including compound: .tar.gz, .spec.ts).
- Directories get no extension.
- Target 2–5 words, ≤60 characters before extension.

Context-aware naming:
- REMOVE GROUP REDUNDANCY: When a file is placed in a group, strip the group \
concept from the filename. In group \"dogs\": \"sitting.png\" not \
\"dogs-sitting.png\", not \"dog-sitting.png\".
- REMOVE DATE REDUNDANCY: If the organizational structure already encodes a \
date (e.g. the parent directory is 2024/03/), strip that date from the \
filename unless it adds sub-day precision that matters.
- ADD DISTINCTION: If two files in the same group would get the same name, \
disambiguate with the most meaningful available signal — a content difference, \
a metadata detail, or a sequential suffix as last resort.

─── SUMMARY ───

- One sentence, ≤15 words, describing the batch at a glance.
- Mention the dominant themes, not individual files.
- Examples: \"tax documents and vacation photos from 2024\", \
\"mixed screenshots, mostly Slack conversations\", \
\"node.js project with scattered downloaded assets\".

─── SELF-CHECK ───

Before responding, verify:
1. Every input id appears exactly once in output.
2. No file has skip: true with a non-null name or group.
3. No group contains fewer than 2 files.
4. No group name matches the parent directory name.
5. No two files in the same group share an identical name.
6. No generic catch-all groups (misc, other, unsorted).
7. All file extensions preserved from originals.
8. Summary is ≤15 words."

organize_batch() {
  local file_pairs_json="$1"

  local parent_name
  parent_name=$(basename "$target_dir")

  local user_text
  user_text="Parent directory: ${parent_name}
Files to organize:
${file_pairs_json}"

  local payload
  payload=$(ai.anthropic_chat_payload "$model" "$ORGANIZE_SYSTEM_PROMPT" "$user_text" 4096)

  local resp
  ai.anthropic_messages resp "$payload" || {
    ai.anthropic_log_error resp "Failed to get organization plan"
    return 1
  }

  if ! http.response_ok resp; then
    ai.anthropic_log_error resp "API error for organization plan"
    return 1
  fi

  local raw
  raw=$(ai.anthropic_message_text resp) || {
    log.error "Failed to parse organization response"
    return 1
  }

  # Strip markdown fences.
  raw="${raw#\`\`\`json}"
  raw="${raw#\`\`\`}"
  raw="${raw%\`\`\`}"

  # Validate JSON structure.
  printf '%s' "$raw" | jq -e '.summary and .files' >/dev/null 2>&1 || {
    log.error "Invalid organization response"
    ((verbose)) && log.error "Raw: $raw"
    return 1
  }

  printf '%s\n' "$raw"
}

## ---------------------------------------------------------------------------
## History / manifest
## ---------------------------------------------------------------------------

write_tidy_records() {
  local date_tag="$1" mode="$2" archive_dir="$3"
  shift 3
  # Remaining args: quads of original, new_name, group, sha1.
  while (($# >= 4)); do
    tidy_append_rename "$date_tag" "$mode" "$1" "$2" "$3" "$4" "$archive_dir"
    shift 4
  done
}

## ---------------------------------------------------------------------------
## Subcommands
## ---------------------------------------------------------------------------

cmd_history() {
  if [[ ! -f $tidy_file ]]; then
    log.info "No history yet — $tidy_file"
    return 0
  fi

  local has_renames=0
  printf 'History for %s:\n\n' "$target_dir"
  while IFS= read -r line; do
    local type
    type=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null) || continue
    [[ $type == rename ]] || continue
    has_renames=1
    local date orig renamed group mode
    date=$(printf '%s' "$line" | jq -r '.date')
    orig=$(printf '%s' "$line" | jq -r '.original')
    renamed=$(printf '%s' "$line" | jq -r '.renamed')
    group=$(printf '%s' "$line" | jq -r '.group')
    mode=$(printf '%s' "$line" | jq -r '.mode')
    if [[ $group == "." ]]; then
      printf '  [%s] %s → %s (%s)\n' "$date" "$orig" "$renamed" "$mode"
    else
      printf '  [%s] %s → %s/%s (%s)\n' "$date" "$orig" "$group" "$renamed" "$mode"
    fi
  done < "$tidy_file"

  if ((! has_renames)); then
    log.info "No renames recorded yet"
  fi
}

cmd_status() {
  if [[ ! -f $tidy_file ]]; then
    log.info "Skip list is empty"
    return 0
  fi

  local has_skips=0
  printf 'Files that will be skipped on subsequent runs:\n\n'
  while IFS= read -r line; do
    local type
    type=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null) || continue
    [[ $type == skip ]] || continue
    has_skips=1
    local sha1 name
    sha1=$(printf '%s' "$line" | jq -r '.sha1')
    name=$(printf '%s' "$line" | jq -r '.name')
    printf '  %s  %s\n' "${sha1:0:12}" "$name"
  done < "$tidy_file"

  if ((! has_skips)); then
    log.info "Skip list is empty"
  fi
}

cmd_revert() {
  if [[ ${#subcmd_args[@]} -eq 0 ]]; then
    log.error "Usage: tidy revert DATE [DIRECTORY]"
    return 1
  fi

  local date_tag
  date_tag=$(normalize_date_arg "${subcmd_args[0]}") || return 1

  if [[ ! -f $tidy_file ]]; then
    log.error "No .tidy file found in $target_dir"
    return 1
  fi

  local reverted=0 skipped=0
  while IFS= read -r line; do
    local type date mode original renamed group sha1 archive_dir
    type=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null) || continue
    [[ $type == rename ]] || continue

    date=$(printf '%s' "$line" | jq -r '.date')
    [[ $date == "$date_tag" ]] || continue

    mode=$(printf '%s' "$line" | jq -r '.mode')
    original=$(printf '%s' "$line" | jq -r '.original')
    renamed=$(printf '%s' "$line" | jq -r '.renamed')
    group=$(printf '%s' "$line" | jq -r '.group')
    sha1=$(printf '%s' "$line" | jq -r '.sha1')
    archive_dir=$(printf '%s' "$line" | jq -r '.archive // "."')

    local src dst
    if [[ $mode == archive ]]; then
      if [[ $group == "." ]]; then
        src="$archive_dir/$renamed"
      else
        src="$archive_dir/$group/$renamed"
      fi
      dst="$target_dir/$original"
    else
      # inplace mode — renamed file is in the target dir (possibly in a group subdir)
      if [[ $group == "." ]]; then
        src="$target_dir/$renamed"
      else
        src="$target_dir/$group/$renamed"
      fi
      dst="$target_dir/$original"
    fi

    if [[ ! -e $src ]]; then
      log.warn "Source not found: $src"
      skipped=$((skipped + 1))
      continue
    fi

    if [[ -e $dst ]]; then
      log.warn "Already exists: $original"
      skipped=$((skipped + 1))
      continue
    fi

    if ((dry_run)); then
      printf '  %s → %s\n' "$(basename "$src")" "$original"
    else
      if [[ $mode == archive ]]; then
        cp -R -- "$src" "$dst"
      else
        mv -- "$src" "$dst"
      fi
      skiplist_add "$sha1" "$original"
      ((verbose)) && log.success "Reverted: $original"
    fi
    reverted=$((reverted + 1))
  done < "$tidy_file"

  if ((reverted == 0 && skipped == 0)); then
    log.info "No renames found for date $date_tag"
    return 0
  fi

  if ((dry_run)); then
    log.info "Dry run — $reverted file(s) would be reverted"
  else
    log.success "Reverted $reverted file(s)"
    if ((skipped)); then
      log.warn "Skipped $skipped file(s)"
    fi
  fi
}

## ---------------------------------------------------------------------------
## Main organize flow
## ---------------------------------------------------------------------------

resolve_api_key() {
  [[ -n ${ANTHROPIC_API_KEY:-} ]] && return 0
  # Source .profile.local if it exists (common location for API keys).
  if [[ -f "$HOME/.profile.local" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.profile.local" 2>/dev/null || true
    [[ -n ${ANTHROPIC_API_KEY:-} ]] && return 0
  fi
  local keyfile
  for keyfile in "$HOME/.anthropic/api_key" "$HOME/.config/anthropic/api_key"; do
    if [[ -f $keyfile ]]; then
      ANTHROPIC_API_KEY=$(<"$keyfile")
      ANTHROPIC_API_KEY=$(printf '%s' "$ANTHROPIC_API_KEY" | tr -d '[:space:]')
      export ANTHROPIC_API_KEY
      return 0
    fi
  done
  if command -v security >/dev/null 2>&1; then
    local val
    val=$(security find-generic-password -s "ANTHROPIC_API_KEY" -w 2>/dev/null || true)
    if [[ -n $val ]]; then
      ANTHROPIC_API_KEY="$val"
      export ANTHROPIC_API_KEY
      return 0
    fi
  fi
  return 1
}

process_directory() {
  target_dir="$1"
  tidy_file="$target_dir/.tidy"

  # Collect files and directories (non-hidden), skipping the skip list.
  local entry base sha

  files=()
  file_sha1s=()
  file_kinds=()
  file_contexts=()
  file_preview_paths=()
  file_preview_media_types=()
  file_preview_notes=()
  related_hints=()
  duplicate_of=()

  for entry in "$target_dir"/*; do
    [[ -f $entry || -d $entry ]] || continue
    base=$(basename "$entry")
    [[ $base != .* ]] || continue

    sha=$(file_sha1 "$entry")
    if skiplist_contains "$sha"; then
      ((verbose)) && log.info "Skipping (on skip list): $base"
      continue
    fi

    if ((min_age_hours > 0)); then
      local mtime now age_seconds
      mtime=$(stat -f '%m' "$entry")
      now=$(date +%s)
      age_seconds=$((now - mtime))
      if ((age_seconds < min_age_hours * 3600)); then
        ((verbose)) && log.info "Too recent ($((age_seconds / 3600))h): $base"
        continue
      fi
    fi

    files+=("$base")
    file_sha1s+=("$sha")
  done

  if ((${#files[@]} == 0)); then
    log.info "Nothing found in $target_dir"
    return 0
  fi

  log.info "Found ${#files[@]} item(s) in $target_dir"

  precompute_file_context

  local -a duplicate_orig=() duplicate_keep=()
  local duplicate_count=0
  local i filename
  for ((i = 0; i < ${#files[@]}; i++)); do
    if [[ -n ${duplicate_of[$i]:-} ]]; then
      duplicate_orig+=("${files[$i]}")
      duplicate_keep+=("${duplicate_of[$i]}")
      duplicate_count=$((duplicate_count + 1))
    fi
  done

  # Phase 1: get suggested names. Vision files are handled individually;
  # text-only files are batched into groups of BATCH_SIZE for efficiency.
  local -a suggested_names=()
  local api_errors=0
  local -a text_batch_indices=()

  for ((i = 0; i < ${#files[@]}; i++)); do
    suggested_names[$i]=""
  done

  for ((i = 0; i < ${#files[@]}; i++)); do
    filename="${files[$i]}"
    if [[ -n ${duplicate_of[$i]:-} ]]; then
      ((verbose)) && log.info "Skipping duplicate candidate: $filename"
      continue
    fi

    if [[ -n ${file_preview_paths[$i]:-} && -n ${file_preview_media_types[$i]:-} ]]; then
      # Vision file — must be handled individually.
      ((verbose)) && log.info "Asking Claude about (vision): $filename"
      local name
      if ! name=$(suggest_name_for_index "$i"); then
        log.warn "Skipping: $filename (API error)"
        api_errors=$((api_errors + 1))
        continue
      fi
      if [[ -z $name ]]; then
        log.warn "Skipping: $filename (empty suggestion)"
        api_errors=$((api_errors + 1))
        continue
      fi
      suggested_names[$i]="$name"
    else
      # Text-only file — queue for batch processing.
      text_batch_indices+=("$i")
    fi
  done

  # Process text-only files in batches.
  if ((${#text_batch_indices[@]} > 0)); then
    local batch_start=0
    while ((batch_start < ${#text_batch_indices[@]})); do
      local -a current_batch=()
      local batch_end=$((batch_start + BATCH_SIZE))
      ((batch_end > ${#text_batch_indices[@]})) && batch_end=${#text_batch_indices[@]}

      for ((i = batch_start; i < batch_end; i++)); do
        current_batch+=("${text_batch_indices[$i]}")
      done

      ((verbose)) && log.info "Naming batch of ${#current_batch[@]} text-only file(s)"
      if ! suggest_names_batch "${current_batch[@]}"; then
        log.warn "Batch naming failed, falling back to individual calls"
        for idx in "${current_batch[@]}"; do
          filename="${files[$idx]}"
          ((verbose)) && log.info "Asking Claude about: $filename"
          local name
          if ! name=$(suggest_name_for_index "$idx"); then
            log.warn "Skipping: $filename (API error)"
            api_errors=$((api_errors + 1))
            continue
          fi
          if [[ -z $name ]]; then
            log.warn "Skipping: $filename (empty suggestion)"
            api_errors=$((api_errors + 1))
            continue
          fi
          suggested_names[$idx]="$name"
        done
      fi

      batch_start=$batch_end
    done

    # Check for files that didn't get a name from batch (API omitted them).
    for idx in "${text_batch_indices[@]}"; do
      if [[ -z ${suggested_names[$idx]:-} ]]; then
        filename="${files[$idx]}"
        ((verbose)) && log.info "Retrying individually: $filename"
        local name
        if name=$(suggest_name_for_index "$idx") && [[ -n $name ]]; then
          suggested_names[$idx]="$name"
        else
          log.warn "Skipping: $filename (no suggestion)"
          api_errors=$((api_errors + 1))
        fi
      fi
    done
  fi

  # Build JSON array for Phase 2, filtering out files that failed Phase 1.
  # Each entry gets a numeric "id" so we can map results back by index
  # instead of relying on Claude to reproduce the exact original filename.
  local pairs_json="["
  local first=1 have_pairs=0
  local -a pair_index_map=()  # maps pair position → files[] index

  for ((i = 0; i < ${#files[@]}; i++)); do
    [[ -n ${suggested_names[$i]} ]] || continue
    have_pairs=1
    pair_index_map+=("$i")

    local orig_label="${files[$i]}"
    # Mark directories with trailing / so Claude can distinguish them.
    [[ -d "$target_dir/$orig_label" ]] && orig_label+="/"

    local orig_json sugg_json kind_json context_json related_json
    orig_json=$(json.escape "$orig_label")
    sugg_json=$(json.escape "${suggested_names[$i]}")
    kind_json=$(json.escape "${file_kinds[$i]}")
    context_json=$(json.escape "${file_contexts[$i]}")
    related_json=$(json.escape "${related_hints[$i]}")

    if ((first)); then
      first=0
    else
      pairs_json+=","
    fi
    pairs_json+="{\"id\":$i,\"original\":\"$orig_json\",\"suggested\":\"$sugg_json\",\"kind\":\"$kind_json\",\"context\":\"$context_json\",\"related\":\"$related_json\"}"
  done
  pairs_json+="]"

  # Parse the plan into arrays.
  local -a move_orig=() move_name=() move_group=() move_sha=()
  local -a skip_files=()
  local summary="desktop files"

  if ((have_pairs)); then
    # Phase 2: ask Claude to group, flag skips, and summarize.
    ((verbose)) && log.info "Asking Claude to organize the batch"

    local plan
    if ! plan=$(organize_batch "$pairs_json"); then
      log.error "Failed to get organization plan"
      return 1
    fi

    summary=$(printf '%s' "$plan" | jq -r '.summary // "files"')

    local file_count
    file_count=$(printf '%s' "$plan" | jq -r '.files | length')

    local j
    for ((j = 0; j < file_count; j++)); do
      local file_id name group do_skip
      file_id=$(printf '%s' "$plan" | jq -r ".files[$j].id // empty")
      name=$(printf '%s' "$plan" | jq -r ".files[$j].name // empty")
      group=$(printf '%s' "$plan" | jq -r ".files[$j].group // empty")
      do_skip=$(printf '%s' "$plan" | jq -r ".files[$j].skip")

      # Map back to original filename via id → files[] index.
      local orig=""
      if [[ -n $file_id ]] && ((file_id >= 0 && file_id < ${#files[@]})); then
        orig="${files[$file_id]}"
      else
        # Fallback: try matching by the original field Claude returned.
        orig=$(printf '%s' "$plan" | jq -r ".files[$j].original // empty")
        orig="${orig%/}"
      fi
      [[ -n $orig ]] || continue

      if [[ $do_skip == "true" ]]; then
        skip_files+=("$orig")
        continue
      fi

      [[ -n $name ]] || continue

      # Look up the SHA1 by files[] index (prefer id) or by name scan.
      local sha=""
      if [[ -n $file_id ]] && ((file_id >= 0 && file_id < ${#files[@]})); then
        sha="${file_sha1s[$file_id]}"
      else
        for ((i = 0; i < ${#files[@]}; i++)); do
          if [[ ${files[$i]} == "$orig" ]]; then
            sha="${file_sha1s[$i]}"
            break
          fi
        done
      fi

      # Enforce: group must not match parent directory name.
      local parent_name
      parent_name=$(basename "$target_dir")
      if [[ -n $group && $group == "$parent_name" ]]; then
        ((verbose)) && log.info "Suppressing group '$group' (same as parent dir)"
        group=""
      fi

      # Enforce: strip group prefix from filename when grouped.
      if [[ -n $group && $group != "." ]]; then
        local stem ext_part stripped
        ext_part=$(file_ext "$name")
        stem=$(file_stem "$name")
        # Remove group as a prefix (with optional separator).
        stripped=$(printf '%s' "$stem" | sed -E "s/^${group}[- _]?//")
        if [[ -n $stripped && $stripped != "$stem" ]]; then
          if [[ -n $ext_part ]]; then
            name="${stripped}.${ext_part}"
          else
            name="$stripped"
          fi
          ((verbose)) && log.info "Truncated group prefix: $name"
        fi
      fi

      move_orig+=("$orig")
      move_name+=("$name")
      move_group+=("${group:-.}")
      move_sha+=("$sha")
    done
  fi

  if ((${#move_orig[@]} == 0 && duplicate_count == 0)); then
    if ((${#skip_files[@]} > 0)); then
      log.info "All files flagged as desktop keepers:"
      for filename in "${skip_files[@]}"; do
        printf '  %s\n' "$filename"
      done
    else
      log.info "Nothing to do"
    fi
    return 0
  fi

  local date_tag mode base_dir
  date_tag=$(today_tag)

  if [[ -n $archive_root ]]; then
    mode="archive"
    base_dir="$archive_root/$date_tag"
  else
    mode="inplace"
    base_dir="$target_dir"
  fi

  # Preview.
  printf '\n'
  if [[ $mode == archive ]]; then
    printf '  Archive: %s/\n\n' "$base_dir"
  else
    printf '  Renaming in place: %s/\n\n' "$target_dir"
  fi
  printf '  %-40s  %s\n' "CURRENT" "DESTINATION"
  printf '  %s\n' "$(printf '%.0s─' {1..80})"

  for ((i = 0; i < ${#move_orig[@]}; i++)); do
    local dest
    if [[ ${move_group[$i]} == "." ]]; then
      dest="${move_name[$i]}"
    else
      dest="${move_group[$i]}/${move_name[$i]}"
    fi
    printf '  %-40s  %s\n' "${move_orig[$i]}" "$dest"
  done
  printf '\n'

  if ((duplicate_count > 0)); then
    printf '  Exact duplicates to Trash:\n'
    for ((i = 0; i < ${#duplicate_orig[@]}; i++)); do
      printf '    %s  →  duplicate of %s\n' "${duplicate_orig[$i]}" "${duplicate_keep[$i]}"
    done
    printf '\n'
  fi

  if ((${#skip_files[@]} > 0)); then
    printf '  Staying in place:\n'
    for filename in "${skip_files[@]}"; do
      printf '    %s\n' "$filename"
    done
    printf '\n'
  fi

  if ((api_errors)); then
    log.warn "Skipped $api_errors file(s) due to API errors"
  fi

  if ((dry_run)); then
    log.info "Dry run — no changes were applied"
    return 0
  fi

  # Confirm.
  if ((auto_approve)); then
    ((verbose)) && log.info "Auto-approved (--yes)"
  else
    printf 'Apply these changes? [y/N] '
    local answer
    read -r answer
    case "$answer" in
    [yY] | [yY][eE][sS]) ;;
    *)
      log.info "Aborted"
      return 0
      ;;
    esac
  fi

  # Apply.
  local moved=0
  local duplicates_removed=0
  local -a tidy_args=()

  for ((i = 0; i < ${#move_orig[@]}; i++)); do
    local src="$target_dir/${move_orig[$i]}"
    local dest_dir="$base_dir"

    if [[ ${move_group[$i]} != "." ]]; then
      dest_dir="$base_dir/${move_group[$i]}"
    fi

    local dst="$dest_dir/${move_name[$i]}"

    if [[ ! -d $dest_dir ]]; then
      ((verbose)) && log.info "Creating: $dest_dir"
      mkdir -p "$dest_dir"
    fi

    if [[ -e $dst ]]; then
      log.warn "Target exists, skipping: ${move_orig[$i]}"
      continue
    fi

    if lsof -- "$src" >/dev/null 2>&1; then
      log.warn "File is open, skipping: ${move_orig[$i]}"
      continue
    fi

    mv -- "$src" "$dst"
    ((verbose)) && log.success "${move_orig[$i]} → ${move_name[$i]}"
    moved=$((moved + 1))

    tidy_args+=("${move_orig[$i]}" "${move_name[$i]}" "${move_group[$i]}" "${move_sha[$i]}")
  done

  # Write records to .tidy.
  if ((moved > 0)); then
    local archive_val="."
    [[ $mode == archive ]] && archive_val="$base_dir"
    write_tidy_records "$date_tag" "$mode" "$archive_val" "${tidy_args[@]}"
  fi

  if ((duplicate_count > 0)); then
    for ((i = 0; i < ${#duplicate_orig[@]}; i++)); do
      local dup_path="$target_dir/${duplicate_orig[$i]}"
      [[ -e $dup_path ]] || continue
      if "${script_dir}/trash" -f "$dup_path" >/dev/null 2>&1; then
        duplicates_removed=$((duplicates_removed + 1))
        ((verbose)) && log.success "Trashed duplicate: ${duplicate_orig[$i]}"
      else
        log.warn "Failed to trash duplicate: ${duplicate_orig[$i]}"
      fi
    done
  fi

  local verb="Renamed"
  [[ $mode == archive ]] && verb="Archived"

  local result_msg=""
  if ((moved > 0 && duplicates_removed > 0)); then
    result_msg="$verb $moved file(s), trashed $duplicates_removed duplicate(s) — $summary"
  elif ((moved > 0)); then
    result_msg="$verb $moved file(s) — $summary"
  elif ((duplicates_removed > 0)); then
    result_msg="Trashed $duplicates_removed duplicate file(s)"
  fi

  if [[ -n $result_msg ]]; then
    log.success "$result_msg"
    if command -v osascript >/dev/null 2>&1; then
      osascript -e "display notification \"$result_msg\" with title \"Tidy\"" 2>/dev/null || true
    fi
  else
    log.info "No changes applied"
  fi
}

main() {
  guards.require_exec jq
  guards.require_exec curl
  guards.require_exec base64
  guards.require_exec shasum

  if ! resolve_api_key; then
    log.error "ANTHROPIC_API_KEY not found in env, key files, or Keychain"
    log.info "Set the env var or place your key in ~/.anthropic/api_key"
    return 1
  fi

  guards.require_dir "$target_dir"

  if [[ -n $archive_root ]]; then
    guards.require_dir "$(dirname "$archive_root")"
  fi

  if ! lock_spec=$(lock.acquire "tidy-$(printf '%s' "$target_dir" | shasum | cut -c1-8)" "$verbose"); then
    log.info "Another instance is running; exiting"
    return 0
  fi

  if ((recursive)); then
    # Process subdirectories depth-first so that renames in children
    # complete before the parent inspects directory names.
    local sub
    while IFS= read -r -d '' sub; do
      [[ $sub != "$target_dir" ]] || continue
      log.info "Processing: $sub"
      process_directory "$sub"
    done < <(find "$target_dir" -mindepth 1 -type d -not -name '.*' -print0 | sort -rz)
  fi

  process_directory "$target_dir"
}

## ---------------------------------------------------------------------------
## Schedule / Unschedule
## ---------------------------------------------------------------------------

LAUNCHD_LABEL="com.nficano.tidy"

cmd_schedule() {
  local interval="${subcmd_args[0]:-3600}"

  launchd.require_tooling || return 1

  local plist_path logs_dir
  plist_path=$(launchd.agent_plist_path "$LAUNCHD_LABEL")
  logs_dir=$(launchd.logs_dir "$LAUNCHD_LABEL")

  launchd.write_agent_plist \
    "$plist_path" "$LAUNCHD_LABEL" "$interval" \
    "$logs_dir/stdout.log" "$logs_dir/stderr.log" \
    --env "HOME=$HOME" \
    --env "PATH=$PATH" \
    -- "$script_dir/tidy" --yes --min-age 12 \
    --archive "$HOME/Dropbox/backups/oak/desktop" "$HOME/Desktop"

  launchd.bootstrap_agent "$LAUNCHD_LABEL" "$plist_path" "" "$verbose"
  log.success "Scheduled: every $((interval / 60)) minutes"
  log.info "Logs: $logs_dir/"
}

cmd_unschedule() {
  launchd.require_tooling || return 1

  local plist_path
  plist_path=$(launchd.agent_plist_path "$LAUNCHD_LABEL")
  launchd.unload_agent "$LAUNCHD_LABEL" "$plist_path" "" "$verbose"
  rm -f "$plist_path"
  log.success "Unscheduled tidy"
}

## ---------------------------------------------------------------------------
## Dispatch
## ---------------------------------------------------------------------------

parse_args "$@"

case "$subcmd" in
"")           main ;;
revert)       cmd_revert ;;
history)      cmd_history ;;
status)       cmd_status ;;
schedule)     cmd_schedule ;;
unschedule)   cmd_unschedule ;;
*)            log.error "Unknown command: $subcmd"; script.usage 1 ;;
esac
