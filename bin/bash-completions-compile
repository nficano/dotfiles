#!/usr/bin/env bash
#/ Compile Homebrew bash completions into a lazy-loading cache.
#/
#/ Sources every script in $BREW_PREFIX/etc/bash_completion.d once, records
#/ which commands each file registers completions for, and writes
#/ ~/.cache/dotfiles/completions.bash: a small loader that registers stub
#/ completions which source the real file on first <Tab> (bash's
#/ "return 124" retry protocol). Dynamic generators (e.g. `op completion
#/ bash`) are snapshotted into the cache as regular files.
#/
#/ The interactive profile sources the compiled cache instead of eagerly
#/ loading ~236 completion scripts, and re-runs this compiler in the
#/ background whenever bash_completion.d changes.
#/
#/ Usage:
#/    bash-completions-compile

set -Eeuo pipefail

# Stub-based lazy loading needs associative arrays (bash >= 4); re-exec with
# a modern bash when invoked under macOS /bin/bash 3.2.
if ((BASH_VERSINFO[0] < 4)); then
  for _bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x $_bash ]] && exec "$_bash" "$0" "$@"
  done
  echo "bash-completions-compile: requires bash >= 4" >&2
  exit 1
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
  brew_prefix=/opt/homebrew
elif [[ -x /usr/local/bin/brew ]]; then
  brew_prefix=/usr/local
else
  echo "bash-completions-compile: Homebrew not found" >&2
  exit 1
fi

compat_dir="$brew_prefix/etc/bash_completion.d"
framework="$brew_prefix/opt/bash-completion/etc/bash_completion"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
# Deliberately nonexistent: pointing the framework's scan dirs here disables
# its eager bash_completion.d loop (see shell.completions_init).
empty_dir="$cache_dir/noscan.d"
out="$cache_dir/completions.bash"

[[ -d $compat_dir ]] || { echo "bash-completions-compile: no $compat_dir" >&2; exit 1; }
[[ -r $framework ]] || { echo "bash-completions-compile: no $framework" >&2; exit 1; }
mkdir -p "$cache_dir"

# Source every completion file in a throwaway bash and attribute each
# registered command to the file(s) that touched its compspec, preserving
# the alphabetical load order the eager scan would have used.
scan_output=$("$BASH" --norc --noprofile -c '
  compat_dir=$1 framework=$2 empty_dir=$3
  BASH_COMPLETION_COMPAT_DIR=$empty_dir BASH_COMPLETION_DIR=$empty_dir \
    source "$framework" >/dev/null 2>&1
  # bash-completion 1.3 provides these to compat files during its eager dir
  # scan, then unsets them at the end of the framework script; recreate them.
  have() {
    unset -v have
    PATH=$PATH:/sbin:/usr/sbin:/usr/local/sbin type "$1" >/dev/null 2>&1 && have=yes
  }
  UNAME=$(uname -s)
  UNAME=${UNAME/CYGWIN_*/Cygwin}
  USERLAND=$UNAME
  prev=$(complete -p 2>/dev/null | LC_ALL=C sort)
  for f in "$compat_dir"/*; do
    [[ -f $f && -r $f ]] || continue
    case ${f##*/} in *~ | *.bak | *.swp | \#*\#) continue ;; esac
    source "$f" >/dev/null 2>&1 || true
    cur=$(complete -p 2>/dev/null | LC_ALL=C sort)
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      printf "%s\t%s\n" "${line##* }" "$f"
    done < <(LC_ALL=C comm -13 <(printf "%s\n" "$prev") <(printf "%s\n" "$cur"))
    prev=$cur
  done
' scan "$compat_dir" "$framework" "$empty_dir")

# Snapshot dynamic completion generators that the profile used to eval.
if command -v op >/dev/null 2>&1; then
  if op completion bash >"$cache_dir/op-completion.bash" 2>/dev/null; then
    scan_output+=$'\n'"op	$cache_dir/op-completion.bash"
  else
    rm -f "$cache_dir/op-completion.bash"
  fi
fi

# Aggregate: cmd -> colon-separated file list in registration order.
declare -A files_for=()
declare -a cmds=()
while IFS=$'\t' read -r cmd file; do
  [[ -n $cmd && -n $file ]] || continue
  [[ $cmd == */* ]] && cmd=${cmd##*/}
  if [[ -z ${files_for[$cmd]:-} ]]; then
    cmds+=("$cmd")
    files_for[$cmd]=$file
  elif [[ ":${files_for[$cmd]}:" != *":$file:"* ]]; then
    files_for[$cmd]+=":$file"
  fi
done <<<"$scan_output"

if ((${#cmds[@]} == 0)); then
  echo "bash-completions-compile: no completions discovered; not writing $out" >&2
  exit 1
fi

tmp=$(mktemp "$out.XXXXXX")
{
  printf '# Generated by bash-completions-compile; do not edit.\n'
  printf '# Source: %s (%s commands)\n' "$compat_dir" "${#cmds[@]}"
  printf '((BASH_VERSINFO[0] >= 4)) || return 0\n\n'

  printf 'declare -gA __dotfiles_comp_files=(\n'
  for cmd in "${cmds[@]}"; do
    printf '  [%q]=%q\n' "$cmd" "${files_for[$cmd]}"
  done
  printf ')\n\n'

  cat <<LOADER
__dotfiles_comp_load() {
  local cmd=\$1 f
  # Safety net: the profile normally loads the framework at startup.
  if ! declare -F _filedir >/dev/null 2>&1; then
    BASH_COMPLETION_COMPAT_DIR=$(printf '%q' "$empty_dir") \\
      BASH_COMPLETION_DIR=$(printf '%q' "$empty_dir") \\
      source $(printf '%q' "$framework") >/dev/null 2>&1
  fi
  # bash-completion 1.3 compat files expect these while being sourced.
  have() {
    unset -v have
    PATH=\$PATH:/sbin:/usr/sbin:/usr/local/sbin type "\$1" >/dev/null 2>&1 && have=yes
  }
  UNAME=\$(uname -s)
  UNAME=\${UNAME/CYGWIN_*/Cygwin}
  USERLAND=\$UNAME
  complete -r "\$cmd" 2>/dev/null
  local IFS=':'
  for f in \${__dotfiles_comp_files[\$cmd]-}; do
    [[ -r \$f ]] && source "\$f" >/dev/null 2>&1
  done
  unset -f have
  unset UNAME USERLAND have
  # Never leave the command spec-less or bash would call us forever.
  complete -p "\$cmd" >/dev/null 2>&1 || complete -o default -o bashdefault "\$cmd"
  return 124
}

LOADER

  for cmd in "${cmds[@]}"; do
    printf 'complete -F __dotfiles_comp_load %q\n' "$cmd"
  done
} >"$tmp"

mv "$tmp" "$out"
echo "compiled ${#cmds[@]} lazy completions -> $out"
