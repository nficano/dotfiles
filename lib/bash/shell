#!/usr/bin/env bash

# Shell primitives akin to Python's subprocess and importlib helpers.
shell.defer() {
  local wrap=0
  if [[ $1 == "--wrap" || $1 == "--force" ]]; then
    wrap=1
    shift
  fi

  local tool="$1"
  shift || true
  if [[ -z $tool || $# -lt 1 ]]; then
    log.error "shell.defer usage: shell.defer [--wrap] <tool> <init-cmd> [args...]"
    return 2
  fi

  if ((wrap == 0)) && command -v "$tool" >/dev/null 2>&1; then
    return 0
  fi

  local init_call
  if [[ $# -eq 1 ]]; then
    local cmd_str="$1"
    local q
    printf -v q '%q' "$cmd_str"
    init_call="eval -- $q"
  else
    local q
    printf -v q '%q ' "$@"
    init_call="$q"
  fi

  eval "
${tool}() {
  unset -f ${tool} 2>/dev/null
  ${init_call}
  if ! command -v ${tool} >/dev/null 2>&1; then
    echo \"shell.defer: '${tool}' not available after initializer\" >&2
    return 127
  fi
  ${tool} \"\$@\"
}
"
}

shell.setopt() {
  sys.path.contains "shopt" && shopt -s "$1"
}

shell.import() {
  if [[ $1 == "--defer" ]]; then
    local tool="$2" file="$3"
    if [[ -z $tool || -z $file ]]; then
      log.error "shell.import --defer <tool> <file>"
      return 2
    fi
    shell.defer "$tool" shell.import "$file"
    return
  fi
  [[ -f $1 ]] && source "$1"
}

shell.eval() {
  if [[ $1 == "--defer" ]]; then
    local tool="$2"
    shift 2 || true
    shell.defer "$tool" shell.eval "$1"
    return
  fi
  eval "$($1)"
}

# shell.completions_init FRAMEWORK_SCRIPT COMPAT_DIR
# Load the bash-completion framework with its eager compat-directory scan
# disabled, then source the compiled lazy-loading map produced by
# shell-completions-compile (per-command files load on first <Tab>).
# Falls back to a full eager load when no compiled map exists or on bash 3.x,
# and recompiles in the background whenever COMPAT_DIR changes.
shell.completions_init() {
  local framework="$1" compat_dir="$2"
  [[ -r $framework ]] || return 0

  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  local compiled="$cache_dir/completions.bash"
  # Deliberately nonexistent: the framework skips its eager directory scan
  # when the dir fails its -d test, without even forking an ls.
  local empty="$cache_dir/noscan.d"

  if ((BASH_VERSINFO[0] >= 4)) && [[ -s $compiled ]]; then
    BASH_COMPLETION_COMPAT_DIR="$empty" BASH_COMPLETION_DIR="$empty" \
      source "$framework"
    source "$compiled"
    if [[ $compat_dir -nt $compiled ]] && sys.path.contains shell-completions-compile; then
      (shell-completions-compile >/dev/null 2>&1 &)
    fi
  else
    source "$framework"
    if ((BASH_VERSINFO[0] >= 4)) && sys.path.contains shell-completions-compile; then
      (shell-completions-compile >/dev/null 2>&1 &)
    fi
  fi
}

shell.setup_prompt() {
  export -n PS1 2>/dev/null || true
  PS1="\h \[\e[1;32m\]\$(if command -v shell.iterm2_style_path >/dev/null 2>&1; then shell.iterm2_style_path; else dirs +0; fi)\[\e[0m\] [\A] > "
}

shell.setup_tab_safe_history() {
  if ! declare -f __dotfiles_history_sync >/dev/null 2>&1; then
    __dotfiles_history_sync() {
      builtin history -a
      builtin history -n
    }
  fi

  if [[ ${PROMPT_COMMAND:-} == *__dotfiles_history_sync* ]]; then
    return 0
  fi

  export -n PROMPT_COMMAND 2>/dev/null || true

  if [[ -n ${PROMPT_COMMAND:-} ]]; then
    PROMPT_COMMAND="__dotfiles_history_sync; ${PROMPT_COMMAND}"
  else
    PROMPT_COMMAND="__dotfiles_history_sync"
  fi
}

# Abbreviate $PWD iTerm2-style (~/c/dotfiles) using only parameter
# expansion; this runs inside PS1 on every prompt, so no subshells.
shell.iterm2_style_path() {
  local p=$PWD
  [[ $p == "$HOME" || $p == "$HOME"/* ]] && p="~${p#"$HOME"}"
  local buffer="" rest=$p seg
  while [[ $rest == */* ]]; do
    seg=${rest%%/*}
    rest=${rest#*/}
    buffer+="${seg:0:1}/"
  done
  echo -n "$buffer$rest"
}
