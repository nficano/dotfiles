# Propagate secrets to the macOS GUI (launchd) environment so that
# GUI apps (Cursor, Antigravity, Automator) and their subprocesses inherit them.
# Empty/unset vars are actively cleared from launchd so disabling a var in
# ~/.profile.local actually takes effect for new GUI launches.
# The eight launchctl round-trips cost ~35ms, so skip them when neither the
# values nor the boot session changed (launchd env resets on reboot).
if sys.path.contains launchctl; then
  _lc_vars=(ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_CUSTOM_HEADERS OPENAI_API_KEY GITHUB_PERSONAL_ACCESS_TOKEN LITELLM_CODEX_KEY S3_UPLOAD_LINK_BUCKET S3_UPLOAD_LINK_URL_BASE S3_UPLOAD_LINK_EXPIRES_IN)
  _lc_state="$(cache.dir)/launchd-env.sig"
  _lc_sig=""
  for _var in "${_lc_vars[@]}"; do
    _lc_sig+="${_var}=${!_var-}"$'\n'
  done
  _lc_sig="$(sysctl -n kern.boottime 2>/dev/null) $(printf '%s' "$_lc_sig" | md5 -q 2>/dev/null || printf '%s' "$_lc_sig" | md5sum)"
  if [[ ! -f $_lc_state || "$(<"$_lc_state")" != "$_lc_sig" ]]; then
    for _var in "${_lc_vars[@]}"; do
      if [[ -n "${!_var}" ]]; then
        launchctl setenv "$_var" "${!_var}"
      else
        launchctl unsetenv "$_var"
      fi
    done
    printf '%s' "$_lc_sig" >"$_lc_state" && chmod 600 "$_lc_state"
  fi
  unset _var _lc_vars _lc_state _lc_sig
fi

