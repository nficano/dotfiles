# Shell Session Command History (shared via Dropbox)
# Append-only, shared history. HISTFILE stays at the conventional
# ~/.bash_history, which `make setup-tree` symlinks to
# ~/Dropbox/system/bash_history so every session on every machine appends to
# one file. Each prompt runs `history -a` (append this session's new lines)
# and `history -n` (pull in other sessions' lines) via
# shell.setup_tab_safe_history below.
os.setenv "HISTFILE" "$HOME/.bash_history"
os.setenv "HISTCONTROL" "ignoreboth"
os.setenv "HISTFILESIZE" -1
os.setenv "HISTSIZE" -1
shell.setopt "histappend" # Append on exit, never clobber the file

