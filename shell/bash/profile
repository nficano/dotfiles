# Only configure Bash; bail immediately if sourced from another shell (e.g., zsh).
if [[ -z ${BASH_VERSION:-} ]]; then
  return
fi

# Terminate for non-interactive sessions or shells without a TTY (Cursor Helper spawns these).

case $- in
*i*)
  if [[ ! -t 0 || ! -t 1 ]]; then
    return
  fi
  ;;
*) return ;;
esac

# Profile load timing (bash >= 5 has EPOCHREALTIME; older bash forks date)
if [[ -n ${EPOCHREALTIME:-} ]]; then
  _PROFILE_START_TIME=$EPOCHREALTIME
elif command -v date >/dev/null 2>&1 && date +%s.%N >/dev/null 2>&1; then
  _PROFILE_START_TIME=$(date +%s.%N)
else
  _PROFILE_START_TIME=$SECONDS
fi

# Resolve dotfiles root so sourcing works via symlinks
if [[ -z ${DOTFILES_ROOT:-} ]]; then
  src=${BASH_SOURCE[0]}

  while [[ -L $src ]]; do
    dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
    target="$(readlink "$src")"
    [[ $target != /* ]] && target="$dir/$target"
    src="$target"
  done

  DOTFILES_ROOT="$(cd -P -- "$(dirname -- "$src")" && pwd)"
  export DOTFILES_ROOT
fi

# Source helper functions
# shellcheck source=/dev/null
source "${DOTFILES_ROOT}/../../lib/bash/initrc"

os.setenv "TERM" "xterm-256color"
os.setenv "GPG_TTY" "$(tty)"
os.setenv "DOTFILES_VERSION" "4.2.0"
os.setenv "DIRENV_SILENT_DIFF" 1

# Python Shell Environment
os.setenv "POETRY_VIRTUALENVS_PATH" "$HOME/.virtualenvs"
os.setenv "PYENV_ROOT" "$HOME/.pyenv"
os.setenv "PYTHONDONTWRITEBYTECODE" true
os.setenv "WORKON_HOME" "$HOME/.virtualenvs"
# Homebrew Shell Environment (macOS only)
when.darwin os.setenv "BREW_PREFIX" "$(brew.prefix)"
when.darwin os.setenv "HOMEBREW_CASKROOM" "$BREW_PREFIX/Caskroom"
when.darwin os.setenv "HOMEBREW_CELLAR" "$BREW_PREFIX/Cellar"
when.darwin os.setenv "HOMEBREW_REPOSITORY" "$BREW_PREFIX/Homebrew"
when.darwin os.setenv "HOMEBREW_SHELLENV_PREFIX" "$BREW_PREFIX"
when.darwin os.setenv "MANPATH" "$BREW_PREFIX/share/man${MANPATH+:$MANPATH}:"
when.darwin os.setenv "INFOPATH" "$BREW_PREFIX/share/info:${INFOPATH:-}"
when.darwin os.setenv "HOMEBREW_NO_ENV_HINTS" 1
when.darwin os.setenv "ARCHFLAGS" "-arch $(sys.machine)"
when.darwin os.setenv "BASH_SILENCE_DEPRECATION_WARNING" 1
os.setenv "HSTR_CONFIG" "hicolor"

# Node.js Environment
os.setenv "NODE_REPL_HISTORY" "$HOME/.node_history" # persistent REPL history
os.setenv "NODE_REPL_HISTORY_SIZE" 32768            # allow 32³ entries
os.setenv "NODE_REPL_MODE" "sloppy"                 # use non-strict mode code
os.setenv "NVM_DIR" "$HOME/.nvm"

# Shell Session Command History (shared via Dropbox)
_HIST_DROPBOX="$HOME/Dropbox/system/bash_history"
if [[ -d "$(dirname "$_HIST_DROPBOX")" ]]; then
  os.setenv "HISTFILE" "$_HIST_DROPBOX"
else
  os.setenv "HISTFILE" "$HOME/.bash_history"
fi
unset _HIST_DROPBOX
os.setenv "HISTCONTROL" "ignoreboth"
os.setenv "HISTFILESIZE" -1
os.setenv "HISTSIZE" -1
shell.setopt "histappend" # Append command history instead of clobbering

os.setenv "SHELL_SESSION_HISTORY" 0 # Disable per-session history (sync via PROMPT_COMMAND)
os.setenv "MANPAGER" "less"
os.setenv "VISUAL" "cursor"
os.setenv "EDITOR" "cursor"
os.setenv "HSTR_TIOCSTI" "y"

# 1Password SSH Agent
when.darwin os.setenv "SSH_AUTH_SOCK" "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

os.setenv "LESS" "-RiF --mouse --wheel-lines=3" # Mouse scoll support

# Set various Bash options.
shell.setopt "cdspell"      # directory name auto-correct during cd.
shell.setopt "checkwinsize" # Update window size after each command.
shell.setopt "cmdhist"      # Save multi-line commands as one.
shell.setopt "hostcomplete"            # tab-complete hostnames.
shell.setopt "no_empty_cmd_completion" # Do not suggest empty commands
                                       # during tab completion.
shell.setopt "nocaseglob" # Case-insensitive path expansion.
shell.setopt "cdspell"    # Automatic spell-correct during
                          # tab completion.
shell.setopt "histverify" # !$ does not execute automatically.

# Untracked Shell Scripts (DO NOT SORT)
sys.path.prepend "$HOME/.bin"

# Prefer GNU Utilities instead of FreeBSD When Available (macOS)
when.darwin sys.path.prepend_many \
  "$BREW_PREFIX/opt/coreutils/libexec/gnubin" \
  "$BREW_PREFIX/opt/findutils/libexec/gnubin" \
  "$BREW_PREFIX/opt/gnu-getopt/libexec/gnubin" \
