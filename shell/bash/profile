# Display profile load time
if [[ -n ${_PROFILE_START_TIME:-} ]]; then
  if [[ -n ${EPOCHREALTIME:-} && $_PROFILE_START_TIME == *.* ]]; then
    # Pure-bash microsecond math; avoids two date and two awk forks.
    _end_time=$EPOCHREALTIME
    _elapsed_us=$(((${_end_time%.*} - ${_PROFILE_START_TIME%.*}) * 1000000 + 10#${_end_time#*.} - 10#${_PROFILE_START_TIME#*.}))
    if ((_elapsed_us > 1000)); then
      printf "\033[2mready (%d.%03ds)\033[0m\n" $((_elapsed_us / 1000000)) $((_elapsed_us % 1000000 / 1000))
    fi
    unset _PROFILE_START_TIME _end_time _elapsed_us
  else
    if command -v date >/dev/null 2>&1 && date +%s.%N >/dev/null 2>&1; then
      end_time=$(date +%s.%N)
      elapsed=$(awk "BEGIN {printf \"%.3f\", $end_time - $_PROFILE_START_TIME}")
    else
      elapsed=$(awk "BEGIN {printf \"%.3f\", $SECONDS - $_PROFILE_START_TIME}")
    fi
    # Only show if load time is significant (> 1ms)
    if awk "BEGIN {exit !($elapsed > 0.001)}" 2>/dev/null; then
      printf "\033[2mready (%.3fs)\033[0m\n" "$elapsed"
    fi
    unset _PROFILE_START_TIME end_time elapsed
  fi
fi
