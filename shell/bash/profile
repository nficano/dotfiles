# Wrapper so `path copy <p> -b/--back` can cd the parent shell to $OLDPWD
# afterward (a child script cannot change the parent shell's directory).
path() {
  local do_back=0 arg
  if [[ ${1:-} == copy ]]; then
    for arg in "$@"; do
      [[ $arg == "-b" || $arg == "--back" ]] && do_back=1
    done
  fi
  command path "$@" || return
  if ((do_back)) && [[ -n ${OLDPWD:-} ]]; then
    builtin cd - >/dev/null
  fi
}

