  "$BREW_PREFIX/opt/gnu-which/libexec/gnubin" \
  "$BREW_PREFIX/opt/grep/libexec/gnubin" \
  "$BREW_PREFIX/opt/whois/bin" \
  "$BREW_PREFIX/opt/icu4c/bin" \
  "$BREW_PREFIX/opt/icu4c/sbin" \
  "$BREW_PREFIX/opt/openssl/bin" \
  "$BREW_PREFIX/opt/openjdk/bin" \
  "$BREW_PREFIX/opt/e2fsprogs/bin" \
  "$BREW_PREFIX/opt/e2fsprogs/sbin" \
  "$BREW_PREFIX/bin" \
  "$BREW_PREFIX/sbin"

# Standard Linux paths (Debian/Ubuntu)
when.debian sys.path.prepend_many \
  "/usr/local/bin" \
  "/usr/local/sbin" \
  "/usr/bin" \
  "/usr/sbin"

# Common user paths (all platforms)
sys.path.prepend_many \
  "$HOME/.local/bin" \
  "$HOME/.docker/bin" \
  "$HOME/.pyenv/bin"

shell.defer --wrap docker shell.import "$HOME/.docker/init-bash.sh"
when.darwin shell.defer --wrap nvm shell.import "$BREW_PREFIX/opt/nvm/nvm.sh"
# Defer virtualenvwrapper until workon/mkvirtualenv is used
when.darwin shell.defer --wrap workon shell.import "$BREW_PREFIX/bin/virtualenvwrapper_lazy.sh"
when.darwin shell.defer --wrap mkvirtualenv shell.import "$BREW_PREFIX/bin/virtualenvwrapper_lazy.sh"
# Completion framework loads eagerly (fast); the ~236 scripts in
# bash_completion.d (gcloud, caddy, yt-dlp, git, op, ...) come from the
# compiled lazy-loading map and each load on first <Tab>. Regenerate with
# bash-completions-compile (automatic when the directory changes).
when.darwin shell.completions_init "$BREW_PREFIX/opt/bash-completion/etc/bash_completion" "$BREW_PREFIX/etc/bash_completion.d"
when.darwin shell.import "$HOME/.iterm2_shell_integration.bash"
# Debian/Ubuntu bash completions
when.debian shell.import "/usr/share/bash-completion/bash_completion" || true
when.debian shell.import "/etc/bash_completion.d" || true
shell.defer --wrap op shell.import "$HOME/.config/op/plugins.sh"

# Use "most" for Manpages when available, otherwise use "less".
sys.path.contains "most" && os.setenv "MANPAGER" "most"

# Use "cursor" for text editing when available, otherwise use "nano".
if sys.path.contains "cursor"; then
  os.setenv "VISUAL" "cursor"
  os.setenv "EDITOR" "cursor"
fi

# Tool init scripts are static per tool version, so source them from cache
# keyed on the tool's binary mtime instead of re-running the generators
# (~330ms of pyenv alone). Rehash runs in the background, not per shell.
#when.cmd aws 'shell.eval "complete -C aws_completer aws"'
when.cmd direnv 'shell.eval_dep_cached direnv_bash "$(command -v direnv)" direnv hook bash'
when.cmd pyenv 'shell.eval_dep_cached pyenv_path_bash "$(command -v pyenv)" pyenv init --path --no-rehash bash'
when.cmd pyenv 'shell.eval_dep_cached pyenv_init_bash "$(command -v pyenv)" pyenv init - --no-rehash bash'
when.cmd pyenv 'shell.eval_dep_cached pyenv_venv_bash "$(command -v pyenv)" pyenv virtualenv-init - bash'
when.cmd pyenv '(command pyenv rehash >/dev/null 2>&1 &)'
when.cmd rbenv 'shell.eval_dep_cached rbenv_init_bash "$(command -v rbenv)" rbenv init - --no-rehash bash'
#when.cmd zoxide 'shell.eval "zoxide init bash"'
when.cmd dircolors 'shell.eval_dep_cached dircolors "$HOME/.dircolors" dircolors -b "$HOME/.dircolors"'
sys.path.contains "conda" && shell.eval "conda shell.bash hook"

complete -cf sudo # enable sudo tab-complete

