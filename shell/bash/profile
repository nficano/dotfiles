# op completions come from the compiled lazy map (bash-completions-compile)

# Wrapper for cppath --back (scripts cannot cd the parent shell)
cppath() {
  local do_back=0 arg
  for arg in "$@"; do
    [[ $arg == "-b" || $arg == "--back" ]] && do_back=1
  done
  command cppath "$@" || return
  if ((do_back)) && [[ -n ${OLDPWD:-} ]]; then
    builtin cd - >/dev/null
  fi
}

when.my_machine sys.path.append "$HOME/.bin/personal"
when.my_machine sys.path.append "$HOME/.bin/lab"

shell.setup_prompt

# Defer SSH agent initialization until SSH is actually used
shell.defer --wrap ssh ssh_agent.init "$HOME/.ssh-agent.env"
shell.defer --wrap scp ssh_agent.init "$HOME/.ssh-agent.env"
# Note: git deferral removed as git may need SSH agent immediately

# Untracked Private Overrides
shell.import "$HOME/.profile.local"

# Propagate secrets to the macOS GUI (launchd) environment so that
# GUI apps (Cursor, Antigravity) and their subprocesses inherit them.
# Empty/unset vars are actively cleared from launchd so disabling a var in
# ~/.profile.local actually takes effect for new GUI launches.
# The eight launchctl round-trips cost ~35ms, so skip them when neither the
# values nor the boot session changed (launchd env resets on reboot).
if sys.path.contains launchctl; then
  _lc_vars=(ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_CUSTOM_HEADERS OPENAI_API_KEY GITHUB_PERSONAL_ACCESS_TOKEN LITELLM_CODEX_KEY)
  _lc_state="$(cache.dir)/launchd-env.sig"
  _lc_sig=""
  for _var in "${_lc_vars[@]}"; do
    _lc_sig+="${_var}=${!_var-}"$'\n'
  done
  _lc_sig="$(sysctl -n kern.boottime 2>/dev/null) $(printf '%s' "$_lc_sig" | md5 -q 2>/dev/null || printf '%s' "$_lc_sig" | md5sum)"
  if [[ ! -f $_lc_state || "$(<"$_lc_state")" != "$_lc_sig" ]]; then
    for _var in "${_lc_vars[@]}"; do
      if [[ -n "${!_var}" ]]; then
        launchctl setenv "$_var" "${!_var}"
      else
        launchctl unsetenv "$_var"
      fi
    done
    printf '%s' "$_lc_sig" >"$_lc_state" && chmod 600 "$_lc_state"
  fi
  unset _var _lc_vars _lc_state _lc_sig
fi

shell.setup_tab_safe_history # prevent history loss when working with tabs

# Display profile load time
if [[ -n ${_PROFILE_START_TIME:-} ]]; then
  if [[ -n ${EPOCHREALTIME:-} && $_PROFILE_START_TIME == *.* ]]; then
    # Pure-bash microsecond math; avoids two date and two awk forks.
    _end_time=$EPOCHREALTIME
    _elapsed_us=$(((${_end_time%.*} - ${_PROFILE_START_TIME%.*}) * 1000000 + 10#${_end_time#*.} - 10#${_PROFILE_START_TIME#*.}))
    if ((_elapsed_us > 1000)); then
      printf "\033[2mready (%d.%03ds)\033[0m\n" $((_elapsed_us / 1000000)) $((_elapsed_us % 1000000 / 1000))
    fi
    unset _PROFILE_START_TIME _end_time _elapsed_us
  else
    if command -v date >/dev/null 2>&1 && date +%s.%N >/dev/null 2>&1; then
      end_time=$(date +%s.%N)
      elapsed=$(awk "BEGIN {printf \"%.3f\", $end_time - $_PROFILE_START_TIME}")
    else
      elapsed=$(awk "BEGIN {printf \"%.3f\", $SECONDS - $_PROFILE_START_TIME}")
    fi
    # Only show if load time is significant (> 1ms)
    if awk "BEGIN {exit !($elapsed > 0.001)}" 2>/dev/null; then
      printf "\033[2mready (%.3fs)\033[0m\n" "$elapsed"
    fi
    unset _PROFILE_START_TIME end_time elapsed
  fi
fi
. "$HOME/.cargo/env"
